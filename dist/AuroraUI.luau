			local cancelLabel = Util.Text({
				Text = modalConfig.CancelText or "Cancel",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = Util.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = cancel,
			})
			Util.Themable(cancelLabel, "TextColor3", "Text")
			Util.OnClick(cancel, destroy)

			local confirm = Util.New("Frame", {
				Name = "Confirm",
				BackgroundColor3 = Util.Theme.Accent,
				Size = UDim2.fromOffset(96, 32),
				BorderSizePixel = 0,
				Parent = actions,
			})
			Util.Corner(9, confirm)
			Util.Gradient(ColorSequence.new(Util.Theme.Accent, Util.Theme.Accent2), 0, confirm)
			local confirmLabel = Util.Text({
				Text = modalConfig.ConfirmText or "Confirm",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = Util.Theme.AccentText,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = confirm,
			})
			Util.OnClick(confirm, function()
				destroy()
				Util.SafeCall(modalConfig.OnConfirm)
			end)

			Util.OnClick(catcher, destroy)

			return dialog
		end

		------------------------------------------------------------------
		-- Launcher: the logo that opens the UI again
		-- Closing the window must never be a dead end. The launcher is the
		-- window's own icon (config.Icon, default the sparkle mark) in an
		-- accent chip; it hides while the menu is up and comes back the
		-- moment the menu closes. It is built on every platform, not just
		-- touch ones -- a phone has no RightShift to press and a desktop
		-- may have rebound it, so both need something to click.
		------------------------------------------------------------------
		if config.MobileButton ~= false and config.Launcher ~= false then
			local fab = Util.New("Frame", {
				Name = "Launcher",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 16, 0.5, -60),
				Size = UDim2.fromOffset(48, 48),
				BackgroundColor3 = Util.Theme.Accent,
				BorderSizePixel = 0,
				ZIndex = 40,
				Visible = false,
				Parent = gui,
			})
			Util.Corner(999, fab)

			local fabGradient = Util.Gradient(
				ColorSequence.new(Util.Theme.Accent, Util.Theme.Accent2),
				45,
				fab
			)
			Util.Themable(fab, "BackgroundColor3", "Accent")
			Util.Themable(fabGradient, "Color", function(palette)
				return ColorSequence.new(palette.Accent, palette.Accent2)
			end)

			local fabStroke = Util.Stroke(Util.Theme.AccentText, 1.5, 0.75, fab)
			Util.Themable(fabStroke, "Color", "AccentText")

			local fabScaleReference = Util.Scale(fab)

			local fabIcon = Icons.Get(config.Icon or "sparkle", fab, {
				Size = 20,
				Color = Util.Theme.AccentText,
				Mask = Util.Theme.Accent,
			})
			fabIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			fabIcon.Position = UDim2.fromScale(0.5, 0.5)

			fab:SetAttribute("Tooltip", config.Title or "Menu")

			-- Drag to reposition (tap still opens the window).
			local fabStart, fabPosition, moved = nil, nil, false
			Util.Drag(fab, function(deltaX, deltaY)
				if math.abs(deltaX) + math.abs(deltaY) > 6 then
					moved = true
				end
				if not fabStart then
					return
				end
				local viewport = Util.Viewport()
				local x = math.clamp(fabPosition.X + deltaX, 0, viewport.X - fab.AbsoluteSize.X)
				local y = math.clamp(fabPosition.Y + deltaY, 0, viewport.Y - fab.AbsoluteSize.Y)
				fab.Position = UDim2.fromOffset(x, y)
			end, function()
				fabPosition = fab.AbsolutePosition
				moved = false
				Util.Tween(fabScaleReference, { Scale = 0.94 }, "Fast")
			end, function()
				Util.Tween(fabScaleReference, { Scale = 1 }, "Spring")
				if not moved then
					self:Open()
				end
			end)

			-- kept as _mobileToggle too: older scripts poke at that name
			self._mobileToggle = fab
			self.Launcher = fab
		end

		--- Show or hide the launcher directly. `Close()` and `Open()` already
		--- do this; use it if you want the logo on screen while the menu is up.
		function self:SetLauncherVisible(visible: boolean)
			if self._mobileToggle and self._mobileToggle.Parent then
				self._mobileToggle.Visible = visible ~= false
			end
		end

		------------------------------------------------------------------
		-- Open / close
		------------------------------------------------------------------
		local function animateOpen()
			main.Visible = true
			fitToViewport()
			mainScale.Scale = baseScale * 0.94
			scaleTo(1, "Spring")

			-- The style's motion profile decides how the contents arrive: the
			-- chrome is already in place, the body staggers in behind it.
			if self._anim then
				self._anim.Entrance(body, motion, 12)
				self._anim.Entry(self._tabBar or sidebar, motion, 0)
			end
			if blur then
				blur.Size = 0
				TweenService:Create(
					blur,
					TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{ Size = Util.Theme.Glass > 0 and 14 or 0 }
				):Play()
			end
		end

		local open = true
		function self:Open()
			if open then
				return
			end
			open = true
			blocker.Visible = true
			if self._mobileToggle then
				self._mobileToggle.Visible = false
			end
			animateOpen()
		end

		function self:Close()
			if not open then
				return
			end
			open = false
			scaleTo(0.94, "Fast")
			task.delay(0.14, function()
				if not open then
					main.Visible = false
					blocker.Visible = false
					if self._mobileToggle then
						self._mobileToggle.Visible = true
					end
					if blur then
						TweenService:Create(blur, TweenInfo.new(0.25), { Size = 0 }):Play()
					end
				end
			end)
		end

		function self:Toggle()
			if open then
				self:Close()
			else
				self:Open()
			end
		end

		function self:IsOpen(): boolean
			return open
		end

		function self:Destroy()
			self.Alive = false
			if blur then
				blur:Destroy()
			end
			gui:Destroy()
		end

		self.Open = self.Open
		animateOpen()

		-- Global keybind ----------------------------------------------------
		if config.Keybind then
			UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if gameProcessed then
					return
				end
				if input.KeyCode == config.Keybind then
					self:Toggle()
				end
			end)
		end

		-- Re-fit on rotation / window resize / studio emulation change.
		local viewportConnection
		viewportConnection = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if self.Alive then
				fitToViewport()
			end
		end)

		Tooltip.Init(self)

		Util.SafeCall(config.OnBuilt, self)
		return self
	end

	return Window
end

Modules["init"] = function()
	--[[
		Aurora UI  •  init.luau
		==================================================================
		A modern Roblox interface kit.

		Quick start
		-----------
			local UI = require(game.ReplicatedStorage.UI.UILibrary)

			local window = UI.CreateWindow({
				Title = "Aurora",
				Subtitle = "v2.0.0  •  ready",
				Keybind = Enum.KeyCode.RightShift,
			})

			local tab = window:CreateTab({ Name = "Main", Icon = "home" })
			local section = tab:CreateSection({ Name = "Gameplay", Icon = "shield" })
			section:AddToggle({ Name = "Enable feature", Default = true, Callback = print })

		Everything is themed through Theme.luau, every control is documented
		in the README, and the demo in StarterPlayerScripts shows real use.
	--]]

	local Theme = __req("Theme")
	local Util = __req("Util")
	local Icons = __req("Icons")
	local Styles = __req("Styles")
	local Window = __req("Window")

	local UILibrary = {}

	UILibrary.Version = "4.4.0"
	UILibrary.Theme = Theme
	UILibrary.Util = Util
	UILibrary.Icons = Icons
	UILibrary.Styles = Styles

	--- Create the main window. Returns a window object with :CreateTab,
	--- :Notify, :Modal, :SetTheme, :Open, :Close and :Toggle.
	function UILibrary.CreateWindow(config: { [string]: any }?)
		return Window.New(config)
	end

	--- Apply a palette globally (affects every open window).
	function UILibrary.SetTheme(name: string)
		Util.ApplyTheme(Theme.Get(name))
		Icons.RefreshAll(game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"), Util.Theme.Surface)
		Theme.Name = name
	end

	--- Returns every palette name (sorted).
	function UILibrary.GetThemes(): { string }
		return Theme.List()
	end

	--- Returns a palette table without applying it.
	function UILibrary.GetTheme(name: string)
		return Theme.Get(name)
	end

	--- Convenience: format a number the way Aurora does ("1.2K").
	function UILibrary.Format(value: number, precision: number?): string
		return Util.FormatNumber(value, precision)
	end

	return UILibrary
end

	return __req("init")
end)()

return Aurora
