		part(root, 10, 8.1, 8.6, 5.4, 0, Color3.new(0, 0, 0), 2.4)
		part(root, 10, 12.7, 5.4, 5.4, 45, Color3.new(0, 0, 0), 1.3)
	end

	Builders.chart = function(root, color)
		part(root, 5.6, 13.4, 3.2, 7, 0, color, 1.4)
		part(root, 10, 10.4, 3.2, 12.6, 0, color, 1.4)
		part(root, 5.6, 10.4, 3.2, 0.1, 0, color, 1.4)
		part(root, 14.4, 6.6, 3.2, 18, 0, color, 1.4)
	end

	Builders.bell = function(root, color)
		part(root, 10, 9, 11, 9, 0, color, 4.6)
		part(root, 10, 14.6, 13.4, 1.9, 0, color, 1)
		circle(root, 10, 17.4, 2.6, color)
	end

	Builders.layers = function(root, color)
		part(root, 10, 5.4, 7.4, 7.4, 45, color, 1.8)
		part(root, 10, 11, 7.4, 7.4, 45, color, 1.8)
		part(root, 10, 16.2, 7.4, 7.4, 45, color, 1.8)
	end

	Builders.code = function(root, color)
		part(root, 6.4, 7.2, 6, 2, -45, color, 1)
		part(root, 6.4, 12.8, 6, 2, 45, color, 1)
		part(root, 13.6, 7.2, 6, 2, 45, color, 1)
		part(root, 13.6, 12.8, 6, 2, -45, color, 1)
	end

	Builders.lock = function(root, color)
		local arch = clip(root, 3.4, 6)
		ring(arch, 10, -2.2, 9.4, color, 2)
		part(root, 10, 14, 11.6, 8, 0, color, 2.6)
		circle(root, 10, 13.4, 2.2, Color3.new(0, 0, 0))
	end

	Builders.dot = function(root, color)
		circle(root, 10, 10, 6, color)
	end

	Builders.sun = function(root, color)
		circle(root, 10, 10, 7.6, color)
		for index = 0, 7 do
			local angle = math.rad(index * 45)
			part(root, 10 + math.cos(angle) * 8.4, 10 + math.sin(angle) * 8.4, 2.6, 2.6, index * 45, color, 1)
		end
	end

	Builders.moon = function(root, color, mask)
		circle(root, 10, 10, 12.4, color)
		circle(root, 13.6, 7.4, 11.2, mask or Color3.new(0, 0, 0))
	end

	Builders.info = function(root, color)
		ring(root, 10, 10, 15, color or Color3.new(1, 1, 1), 2)
		circle(root, 10, 6.4, 2.2, color)
		part(root, 10, 11.6, 2.2, 6.4, 0, color, 1)
	end

	Builders.warning = function(root, color)
		part(root, 10, 5.6, 2.4, 8, 0, color, 1.2)
		circle(root, 10, 15.4, 2.4, color)
		part(root, 10, 12.6, 15.4, 2.2, 0, color, 1.1)
	end

	Builders.eye = function(root, color)
		part(root, 10, 10, 16.2, 10.2, 0, color, 5.1)
		circle(root, 10, 10, 5.2, Color3.new())
		circle(root, 10, 10, 2.2, color)
	end

	Builders.trash = function(root, color)
		part(root, 10, 4.4, 11, 2, 0, color, 1)
		part(root, 9.4, 2.8, 4, 2, 0, color, 1)
		part(root, 10, 12.6, 9.4, 10.6, 0, color, 2.4)
		part(root, 10, 12.6, 1.6, 7, 0, Color3.new(0, 0, 0), 0.8)
	end

	Builders.cloud = function(root, color)
		circle(root, 7.4, 11, 7.4, color)
		circle(root, 12.4, 9, 9, color)
		part(root, 10, 14.6, 13.4, 5.2, 0, color, 2.6)
	end

	Builders.play = function(root, color)
		part(root, 10, 10, 3, 12.4, 45, color, 1.4)
		part(root, 10, 10, 3, 12.4, -45, color, 1.4)
	end

	------------------------------------------------------------------
	-- Public API
	------------------------------------------------------------------

	--- Build an icon. Returns a Frame sized to `opts.Size` pixels.
	-- opts = { Size = number, Color = Color3, Mask = Color3 }
	function Icons.Get(name: string, parent: Instance, opts: { [string]: any }?): Frame
		opts = opts or {}

		local size = opts.Size or 18
		local color = opts.Color or Util.Theme.Text or Color3.new(1, 1, 1)
		local mask = opts.Mask or Util.Theme.Surface or Color3.new(0, 0, 0)

		local root = Util.New("Frame", {
			Name = "Icon_" .. tostring(name),
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			Parent = parent,
		})

		local asset = Icons.Assets[name]
		if asset then
			local image = Util.New("ImageLabel", {
				Name = "AssetIcon",
				BackgroundTransparency = 1,
				Image = asset,
				ImageColor3 = color,
				ImageTransparency = 0,
				Size = UDim2.fromScale(1, 1),
				Parent = root,
			})
			image:SetAttribute("AuroraTintable", true)
			root:SetAttribute("AuroraIconName", name)
			return root
		end

		local holder = Util.New("Frame", {
			Name = "Glyph",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(20, 20),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Parent = root,
		})
		Util.New("UIScale", { Scale = size / 20, Parent = holder })

		local builder = Builders[name] or Builders.dot
		builder(holder, color, mask)

		-- Any piece painted pure black is a "hole" punched out of the glyph;
		-- paint it with the surface color behind the icon instead of tinting it.
		for _, piece in ipairs(holder:GetDescendants()) do
			if piece:IsA("Frame") and piece.BackgroundColor3 == Color3.new(0, 0, 0) then
				piece:SetAttribute("AuroraTintable", nil)
				piece:SetAttribute("AuroraHole", true)
				piece.BackgroundColor3 = mask
			end
		end

		root:SetAttribute("AuroraIconName", name)
		return root
	end

	--- Recolor every tintable piece of an icon (including holes).
	function Icons.Tint(root: Instance, color: Color3, mask: Color3?)
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:GetAttribute("AuroraTintable") then
				if descendant:IsA("ImageLabel") then
					descendant.ImageColor3 = color
				elseif descendant:IsA("Frame") then
					descendant.BackgroundColor3 = color
				end
			end
		end
	end

	--- Recolor icon "holes" (the punched-out shapes) to match the surface
	--- behind them; call whenever the container color changes.
	function Icons.Mask(root: Instance, mask: Color3)
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:GetAttribute("AuroraHole") then
				descendant.BackgroundColor3 = mask
			end
		end
	end

	--- Repaint every icon "hole" in a subtree to match whatever surface is
	--- behind it. Call after a theme swap.
	function Icons.RefreshAll(root: Instance, fallback: Color3?)
		local default = fallback or Util.Theme.Surface or Color3.new(0, 0, 0)

		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:GetAttribute("AuroraHole") and descendant:IsA("Frame") then
				local color = default
				local ancestor = descendant.Parent
				while ancestor and ancestor ~= root do
					if ancestor:IsA("GuiObject") and ancestor.BackgroundTransparency < 0.86 then
						color = ancestor.BackgroundColor3
						break
					end
					ancestor = ancestor.Parent
				end
				descendant.BackgroundColor3 = color
			end
		end
	end

	Icons.List = {}
	for name in pairs(Builders) do
		table.insert(Icons.List, name)
	end
	table.sort(Icons.List)

	return Icons
end

Modules["Anim"] = function()
	--[[
		Aurora UI  •  Anim.luau
		==================================================================
		Motion profiles. Every style carries one, so "Arcade" bounces and
		"Executive" barely moves — without a single component knowing which
		style is active.

			A style's Motion table:
				Entry    rise | pop | fade | glitch | type | snap | bounce
				Hover    glow | lift | press | none
				Idle     shimmer | pulse | blink | scan | none
				Duration seconds for one entrance step
				Stagger  seconds between siblings
				Easing   Linear | Sine | Quad | Quint | Back | Bounce | Elastic

		Everything here is engine-safe: no asset ids, no TextService, no
		keyboard, and every tween is 0.1–0.4 s so it stays smooth on a phone.

			Anim.Entrance(container, motion)     stagger the children in
			Anim.Entry(instance, motion, index)  animate one instance
			Anim.Hover(instance, motion)         attach hover feedback
			Anim.Idle(instance, motion)          attach the idle loop
	--]]

	local TweenService = game:GetService("TweenService")

	local Anim = {}
	Anim.Version = "4.4.0"

	------------------------------------------------------------------
	-- easing lookup
	------------------------------------------------------------------

	local EASING = {
		Linear = Enum.EasingStyle.Linear,
		Sine = Enum.EasingStyle.Sine,
		Quad = Enum.EasingStyle.Quad,
		Quint = Enum.EasingStyle.Quint,
		Back = Enum.EasingStyle.Back,
		Bounce = Enum.EasingStyle.Bounce,
		Elastic = Enum.EasingStyle.Elastic,
	}

	local function easing(name: any): Enum.EasingStyle
		if typeof(name) == "EnumItem" then
			return name
		end
		return EASING[name] or Enum.EasingStyle.Quint
	end

	------------------------------------------------------------------
	-- entry profiles
	------------------------------------------------------------------

	-- `From`  : starting UIScale
	-- `Spin`  : starting rotation, degrees
	-- `Fade`  : also slide background/TextTransparency up and back
	-- `Snap`  : duration multiplier (1 = use the style's duration)
	local ENTRY = {
		rise = { From = 0.955, Lift = 10 },
		pop = { From = 0.86 },
		fade = { From = 1, Fade = true, Snap = 1.4 },
		glitch = { From = 0.98, Spin = 1.8 },
		type = { From = 1, Fade = true, Snap = 0.6 },
		snap = { From = 0.9, Snap = 0.35 },
		bounce = { From = 0.66, Snap = 1.2 },
	}

	--- The UIScale every animated instance carries. Named so callers (and the
	--- dumper) can tell it apart from a layout scale.
	local function scaleOf(instance: GuiObject): UIScale
		local existing = instance:FindFirstChild("MotionScale")
		if existing and existing:IsA("UIScale") then
			return existing
		end
		local scale = Instance.new("UIScale")
		scale.Name = "MotionScale"
		scale.Scale = 1
		scale.Parent = instance
		return scale
	end

	local function tween(instance, seconds, props, style, direction)
		if not instance or not instance.Parent then
			return nil
		end
		local info = TweenInfo.new(
			math.max(0.01, seconds),
			easing(style or "Quint"),
			direction or Enum.EasingDirection.Out
		)
		local created = TweenService:Create(instance, info, props)
		created:Play()
		return created
	end

	local function faded(instance: GuiObject): boolean
		return instance.BackgroundTransparency < 1
			or (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
	end

	------------------------------------------------------------------
	-- public: entry
	------------------------------------------------------------------

	--- Animate one instance in. `index` staggers it behind its siblings.
	function Anim.Entry(instance: GuiObject, motion: { [string]: any }?, index: number?, delay: number?)
		if not instance or not instance.Parent then
			return
		end
		motion = motion or {}
		local profile = ENTRY[motion.Entry or "rise"] or ENTRY.rise
		local duration = (motion.Duration or 0.3) * (profile.Snap or 1)
		local step = (motion.Stagger or 0.03) * (index or 0) + (delay or 0)

		local scale = scaleOf(instance)
		scale.Scale = profile.From or 1

		local startSpin = instance.Rotation
		if profile.Spin then
			instance.Rotation = startSpin + profile.Spin
		end

		local originals = {}
		if profile.Fade and faded(instance) then
			originals.BackgroundTransparency = instance.BackgroundTransparency
			if instance.BackgroundTransparency < 1 then
				instance.BackgroundTransparency = math.min(1, instance.BackgroundTransparency + 0.85)
			end
			if instance:IsA("TextLabel") or instance:IsA("TextBox") then
				originals.TextTransparency = instance.TextTransparency
				instance.TextTransparency = math.min(1, instance.TextTransparency + 0.85)
			end
		end

		task.delay(step, function()
			if not instance.Parent then
				return
			end
			tween(scale, duration, { Scale = 1 }, motion.Easing)
			if profile.Spin then
				tween(instance, duration, { Rotation = startSpin }, "Sine")
			end
			if originals.BackgroundTransparency then
				tween(instance, duration * 1.1, { BackgroundTransparency = originals.BackgroundTransparency }, "Sine")
			end
			if originals.TextTransparency then
				tween(instance, duration * 1.1, { TextTransparency = originals.TextTransparency }, "Sine")
			end
		end)
	end

	--- Stagger every direct GuiObject child of `container` in reading order.
	function Anim.Entrance(container: Instance?, motion: { [string]: any }?, limit: number?)
		if not container then
			return
		end
		local children = {}
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				table.insert(children, child)
			end
		end
		local count = math.min(#children, limit or 14)
		for index = 1, count do
			Anim.Entry(children[index], motion, index - 1)
		end
	end

	------------------------------------------------------------------
	-- public: hover
	------------------------------------------------------------------

	--- Hover feedback driven by the style: glow, lift, press or nothing at all.
	--- Safe on touch: it also fires on tap-start through MouseEnter emulation.
	function Anim.Hover(instance: GuiObject, motion: { [string]: any }?)
		if not instance then
			return
		end
		motion = motion or {}
		local kind = motion.Hover or "lift"
		if kind == "none" then
			return
		end

		local scale = scaleOf(instance)
		local stroke = instance:FindFirstChildOfClass("UIStroke")
		local baseStroke = stroke and stroke.Color or nil
		local baseTransparency = stroke and stroke.Transparency or 0

		instance.MouseEnter:Connect(function()
			if kind == "lift" then
				tween(scale, 0.14, { Scale = 1.025 }, "Quad")
			elseif kind == "press" then
				tween(scale, 0.1, { Scale = 0.975 }, "Quad")
			end
			if kind == "glow" and stroke then
				tween(stroke, 0.16, { Transparency = 0 }, "Sine")
			end
		end)

		instance.MouseLeave:Connect(function()
			tween(scale, 0.18, { Scale = 1 }, "Quad")
			if kind == "glow" and stroke then
				tween(stroke, 0.24, { Transparency = baseTransparency }, "Sine")
			end
		end)

		return { Stroke = baseStroke }
	end

	------------------------------------------------------------------
	-- public: idle
	------------------------------------------------------------------

	local REPEAT_FOREVER = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

	--- The idle loop: what the UI does when nobody is touching it.
	function Anim.Idle(instance: GuiObject, motion: { [string]: any }?)
		if not instance or not instance.Parent then
			return
		end
		motion = motion or {}
		local kind = motion.Idle or "none"
		local seconds = (motion.Duration or 0.3) * 5

		if kind == "pulse" then
			local scale = scaleOf(instance)
			local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			local created = TweenService:Create(scale, info, { Scale = 1.035 })
			created:Play()
			return created
		elseif kind == "shimmer" then
			local gradient = instance:FindFirstChildOfClass("UIGradient")
			if not gradient then
				gradient = Instance.new("UIGradient")
				gradient.Parent = instance
			end
			gradient.Offset = Vector2.new(-1, 0)
			local info = TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1)
			local created = TweenService:Create(gradient, info, { Offset = Vector2.new(1, 0) })
			created:Play()
			return created
		elseif kind == "blink" then
			local base = instance.BackgroundTransparency
			local info = TweenInfo.new(math.max(0.35, seconds * 0.3), Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true)
			local created = TweenService:Create(instance, info, {
				BackgroundTransparency = math.min(1, base + 0.6),
			})
			created:Play()
			return created
		elseif kind == "scan" then
			-- a thin accent line that walks down the container
			local line = Instance.new("Frame")
			line.Name = "ScanLine"
			line.BackgroundColor3 = Color3.new(1, 1, 1)
			line.BackgroundTransparency = 0.88
			line.BorderSizePixel = 0
			line.Size = UDim2.new(1, 0, 0, 1)
			line.Position = UDim2.fromScale(0, 0)
			line.ZIndex = 2
			line.Parent = instance
			local info = TweenInfo.new(math.max(2.4, seconds), Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
			local created = TweenService:Create(line, info, { Position = UDim2.fromScale(0, 1) })
			created:Play()
			return created
		end

		return REPEAT_FOREVER
	end

	--- Apply the whole profile to a control: hover + idle, and return it.
	function Anim.Adopt(instance: GuiObject, motion: { [string]: any }?)
		Anim.Hover(instance, motion)
		if motion and (motion.Idle or "none") ~= "none" then
			Anim.Idle(instance, motion)
		end
		return instance
	end

	return Anim
end

Modules["Styles"] = function()
	--[[
		Aurora UI  •  Styles.luau
		------------------------------------------------------------------
		Twenty-four complete design languages built on one component library.

		A *palette* only changes colours. A *style* changes colour **and**
		form: corner radius, border weight, card treatment, button
		treatment, rail geometry and typography. Pass `Style = "Terminal"`
		to CreateWindow and every component follows.

			UILibrary.CreateWindow({ Style = "Neon Grid" })

		Adding your own style is one table — put it in Styles.All and it
		shows up in the picker, the preview and the docs automatically.
	--]]

	local Theme = __req("Theme")

	local Styles = {}

	local fromHex = Color3.fromHex

	------------------------------------------------------------------
	-- Palette scaffolding
	------------------------------------------------------------------

	--- Builds a full palette from the 22 tokens the components read, so a
	--- style only has to spell out what makes it different.
	local function makePalette(name, swatch, tokens)
		return {
			Name = name,
			Swatch = fromHex(swatch),
			Backdrop = fromHex(tokens.backdrop),
			Panel = fromHex(tokens.panel),
			PanelSolid = fromHex(tokens.panelSolid or tokens.panel),
			Surface = fromHex(tokens.surface),
			SurfaceHover = fromHex(tokens.surfaceHover),
			SurfaceActive = fromHex(tokens.surfaceActive),
			Elevated = fromHex(tokens.elevated or tokens.surface),

			Stroke = fromHex(tokens.stroke),
			StrokeSoft = fromHex(tokens.strokeSoft or tokens.stroke),
			StrokeBright = fromHex(tokens.strokeBright or tokens.stroke),

			Text = fromHex(tokens.text),
			TextMuted = fromHex(tokens.textMuted),
			TextDim = fromHex(tokens.textDim or tokens.textMuted),
			TextInverse = fromHex(tokens.textInverse or "#FFFFFF"),

			Accent = fromHex(tokens.accent),
			Accent2 = fromHex(tokens.accent2 or tokens.accent),
			AccentSoft = fromHex(tokens.accentSoft),
			AccentText = fromHex(tokens.accentText or "#FFFFFF"),

			Success = fromHex(tokens.success or "#34D399"),
			Warning = fromHex(tokens.warning or "#FBBF24"),
			Danger = fromHex(tokens.danger or "#FB7185"),
			Info = fromHex(tokens.info or "#60A5FA"),

			Shadow = fromHex(tokens.shadow or "#000000"),
			Glass = tokens.glass or 0,
		}
	end

	------------------------------------------------------------------
	-- Metric defaults — the "Midnight" look, i.e. what the library did
	-- before styles existed. Anything a style omits falls back to this.
	------------------------------------------------------------------

	-- A style is three things: a palette, a *layout blueprint* and a *motion
	-- profile*. The blueprint decides what the window is made of -- where the
	-- navigation lives, how the numbers are presented, what a section looks
	-- like, whether there is a footer, what decorates the backdrop. The motion
	-- profile decides how it enters, how it reacts and what it does while idle.
	-- Change the blueprint and the same components become a different app.

	-- Layout: Nav     rail | sidebar | tabs | float | dock
	--         Header  bar | strip | hero
	--         Stats   cards | headline | rows | chips | dials
	--         Sections panels | cards | list | console | accordion
	--         Footer  status | ticker | none
	--         Decor   none | glow | grid | scan | dots
	Styles.LayoutDefaults = {
		Nav = "rail",
		NavWidth = 74,
		Header = "bar",
		Stats = "cards",
		Sections = "panels",
		Footer = "status",
		Decor = "none",
	}

	-- Motion: Entry rise | pop | fade | glitch | type | snap | bounce
	--         Hover glow | lift | press | none
	--         Idle  shimmer | scan | blink | pulse | none
	Styles.MotionDefaults = {
		Entry = "rise",
		Hover = "lift",
		Idle = "none",
		Duration = 0.3,
		Stagger = 0.03,
		Easing = "Quad",
	}

	Styles.Defaults = {
		Rail = "rail",          -- rail | tabs | sidebar
		RailWidth = 74,         -- ignored by "tabs"
		Card = "glass",         -- glass | flat | outline | brutal | elevated
		Button = "gradient",    -- gradient | solid | outline | brutal
		TabShape = "rounded",   -- rounded | square | pill
		HeaderCase = "normal",  -- normal | upper
		Density = 1,            -- row height multiplier
		RadiusScale = 1,        -- multiplies every UICorner in the kit
		MaxRadius = 999,        -- clamps it (0 = perfectly square)
		BorderScale = 1,        -- multiplies every UIStroke thickness
		BorderAlphaScale = 1,   -- multiplies stroke transparency
		Shadow = 1,             -- multiplies every drop shadow
		Glow = false,           -- accent halo on the active tab/buttons
		Mono = false,           -- monospace numbers and headings
		SectionGap = 10,
	}

	------------------------------------------------------------------
	-- The ten styles
	------------------------------------------------------------------

	Styles.All = {

		----------------------------------------------------------------
		{
			Slug = "midnight",
			Name = "Midnight",
			Tagline = "Glass panels, indigo-to-cyan gradient, icon rail",
			Mood = "Dark · Glass · Gradient",
			Palette = makePalette("Midnight", "#7C5CFF", {
				backdrop = "#05060A", panel = "#0F121B", surface = "#161A26",
				surfaceHover = "#1C2130", surfaceActive = "#232A3C", elevated = "#1B2030",
				stroke = "#252C3E", strokeSoft = "#1A1F2D", strokeBright = "#39435C",
				text = "#EAEEF9", textMuted = "#8B95AE", textDim = "#5A6379",
				accent = "#7C5CFF", accent2 = "#22D3EE", accentSoft = "#2A2350",
				success = "#34D399", warning = "#FBBF24", danger = "#FB7185", info = "#60A5FA",
				glass = 0.04,
			}),
			Metrics = {
				Rail = "rail", Card = "glass", Button = "gradient",
				RadiusScale = 1, MaxRadius = 20, TabShape = "rounded",
				Shadow = 1, Glow = true,
			},
			Layout = { Nav = "rail", Header = "bar", Stats = "cards", Sections = "panels", Footer = "status", Decor = "glow", NavWidth = 74 },
			Motion = { Entry = "rise", Hover = "glow", Idle = "shimmer", Duration = 0.30, Stagger = 0.035, Easing = "Quint" }
		},

		----------------------------------------------------------------
		{
			Slug = "daylight",
			Name = "Daylight",
			Tagline = "Bright surfaces, soft shadows, friendly and airy",
			Mood = "Light · Soft · Rounded",
			Palette = makePalette("Daylight", "#6D5BFF", {
				backdrop = "#DDE2EF", panel = "#FFFFFF", surface = "#F2F5FB",
				surfaceHover = "#E8EDF8", surfaceActive = "#DCE3F3", elevated = "#FFFFFF",
				stroke = "#DCE2F0", strokeSoft = "#E7EBF5", strokeBright = "#C3CCE0",
				text = "#111827", textMuted = "#6B7690", textDim = "#98A1B5",
				accent = "#6D5BFF", accent2 = "#12B5D6", accentSoft = "#EDEBFF",
				success = "#12B76A", warning = "#E2A008", danger = "#F04438", info = "#2E90FA",
				shadow = "#7A87A8", glass = 0,
			}),
			Metrics = {
				Rail = "rail", Card = "elevated", Button = "gradient",
				RadiusScale = 1.1, MaxRadius = 22, TabShape = "rounded",
				Shadow = 1.5, Glow = false,
			},
			Layout = { Nav = "tabs", Header = "hero", Stats = "headline", Sections = "cards", Footer = "none", Decor = "none", NavWidth = 0 },
			Motion = { Entry = "pop", Hover = "lift", Idle = "none", Duration = 0.26, Stagger = 0.04, Easing = "Back" }
		},

		----------------------------------------------------------------
		{
			Slug = "neon",
			Name = "Neon Grid",
			Tagline = "Cyberpunk: black glass, magenta and cyan glow, hairline borders",
			Mood = "Dark · Sharp · Glow",
			Palette = makePalette("Neon Grid", "#FF2E97", {
				backdrop = "#06040D", panel = "#0B0716", surface = "#120C22",
				surfaceHover = "#1A1030", surfaceActive = "#241542", elevated = "#160E28",
				stroke = "#3A1F6B", strokeSoft = "#241141", strokeBright = "#FF2E97",
				text = "#F3ECFF", textMuted = "#9A86C9", textDim = "#6A5794",
				accent = "#FF2E97", accent2 = "#22F0FF", accentSoft = "#2A0F3E",
				success = "#3DFFA2", warning = "#FFC93C", danger = "#FF4D6D", info = "#22F0FF",
				shadow = "#000000", glass = 0.12,
			}),
			Metrics = {
				Rail = "tabs", Card = "outline", Button = "outline",
				RadiusScale = 0.45, MaxRadius = 8, TabShape = "square",
				BorderScale = 1.4, BorderAlphaScale = 0.4, Shadow = 0.6,
