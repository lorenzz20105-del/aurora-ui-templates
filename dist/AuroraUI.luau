				backdrop = "#0E7A7A", panel = "#C0C0C0", surface = "#D4D0C8",
				surfaceHover = "#DCD8D0", surfaceActive = "#C8C4BC", elevated = "#D4D0C8",
				stroke = "#000000", strokeSoft = "#808080", strokeBright = "#000080",
				text = "#000000", textMuted = "#404040", textDim = "#606060",
				accent = "#000080", accent2 = "#1084D0", accentSoft = "#B0B0D8",
				accentText = "#FFFFFF",
				success = "#008000", warning = "#808000", danger = "#C00000", info = "#0000FF",
				shadow = "#000000", glass = 0,
			}),
			Metrics = {
				Rail = "tabs", Card = "flat", Button = "solid",
				RadiusScale = 0, MaxRadius = 0, TabShape = "square", BorderScale = 1.5,
				BorderAlphaScale = 0, Shadow = 0, HeaderCase = "upper", Density = 0.96
			},
			Layout = { Nav = "tabs", Header = "strip", Stats = "rows", Sections = "list", Footer = "status", Decor = "none", NavWidth = 0 },
			Motion = { Entry = "snap", Hover = "none", Idle = "blink", Duration = 0.12, Stagger = 0, Easing = "Linear" }
		},
	}

	------------------------------------------------------------------
	-- Lookup
	------------------------------------------------------------------

	-- slug -> style, and "Name" -> style, both case-insensitive
	Styles.Index = {}
	for _, style in ipairs(Styles.All) do
		Styles.Index[string.lower(style.Slug)] = style
		Styles.Index[string.lower(style.Name)] = style
	end

	--- Returns a style by slug or display name, falling back to Midnight.
	function Styles.Get(name: string?)
		return Styles.Index[string.lower(name or "")] or Styles.All[1]
	end

	--- Merged layout blueprint: style values on top of Styles.LayoutDefaults.
	function Styles.Layout(style)
		local layout = table.clone(Styles.LayoutDefaults)
		for key, value in pairs(style.Layout or {}) do
			layout[key] = value
		end
		return layout
	end

	--- Merged motion profile: style values on top of Styles.MotionDefaults.
	function Styles.Motion(style)
		local motion = table.clone(Styles.MotionDefaults)
		for key, value in pairs(style.Motion or {}) do
			motion[key] = value
		end
		return motion
	end

	--- Merged metrics: style values on top of Styles.Defaults. The navigation
	--- geometry is derived from the layout blueprint, so `Nav = "dock"` in a
	--- style is enough to move the whole rail to the bottom of the window.
	function Styles.Metrics(style)
		local metrics = table.clone(Styles.Defaults)
		for key, value in pairs(style.Metrics or {}) do
			metrics[key] = value
		end
		local layout = Styles.Layout(style)
		metrics.Rail = layout.Nav
		metrics.RailWidth = layout.NavWidth or metrics.RailWidth
		metrics.Header = layout.Header
		metrics.Footer = layout.Footer
		metrics.Stats = layout.Stats
		metrics.Sections = layout.Sections
		metrics.Decor = layout.Decor
		return metrics
	end

	--- Ordered slugs, used by the preview and the docs generator.
	function Styles.Slugs(): { string }
		local slugs = {}
		for _, style in ipairs(Styles.All) do
			table.insert(slugs, style.Slug)
		end
		return slugs
	end

	--- Registers every style palette with the theme system so the built-in
	--- theme picker and Window:SetTheme() can reach them.
	function Styles.Install()
		for _, style in ipairs(Styles.All) do
			Theme.Palettes[style.Name] = style.Palette
			Theme.Styles = Theme.Styles or {}
			Theme.Styles[style.Name] = Styles.Metrics(style)
		end
	end

	Styles.Install()

	return Styles
end

Modules["Row"] = function()
	--[[
		Aurora UI  •  Row.luau
		------------------------------------------------------------------
		The settings-row shell every control sits inside: title, optional
		description, hover highlight and a right-aligned control slot.
	--]]

	local Util = __req("Util")

	local Row = {}

	export type RowConfig = {
		Name: string?,
		Description: string?,
		Height: number?,
		Padding: number?,
		OnClick: (() -> ())?,
		Clickable: boolean?,
	}

	--- Creates a row and returns a controller table.
	-- fields: Frame, Right, Label, Description, Height, SetLabel, SetDescription
	function Row.Create(parent: Instance, config: RowConfig?)
		config = config or {}

		local hasDescription = config.Description ~= nil and config.Description ~= ""
		-- density lets a style breathe (arcade) or pack rows tighter (executive)
		local density = Util.M("Density", 1)
		local height = config.Height or math.floor((hasDescription and 52 or 44) * density + 0.5)
		local sidePadding = config.Padding or 12

		local frame = Util.New("Frame", {
			Name = "Row_" .. (config.Name or "Control"),
			BackgroundColor3 = Util.Theme.SurfaceHover,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, height),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(10, frame)

		-- Hover highlight -------------------------------------------------
		local hovered = false
		Util.Themable(frame, "BackgroundColor3", function(palette)
			return hovered and palette.SurfaceHover or palette.Surface
		end)

		local function setHover(value: boolean)
			hovered = value
			Util.Tween(frame, { BackgroundTransparency = value and 0.35 or 1 }, "Fast")
		end

		frame.MouseEnter:Connect(function()
			setHover(true)
		end)
		frame.MouseLeave:Connect(function()
			setHover(false)
		end)

		-- Text ------------------------------------------------------------
		local labelWidth = UDim.new(1, -(sidePadding * 2) - 60)

		local label = Util.Text({
			Name = "Label",
			Text = config.Name or "",
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			AnchorPoint = Vector2.new(0, hasDescription and 0 or 0.5),
			Position = hasDescription and UDim2.new(0, sidePadding, 0, 9) or UDim2.new(0, sidePadding, 0.5, 0),
			Size = UDim2.new(labelWidth.Scale, labelWidth.Offset, 0, 17),
			Parent = frame,
		})
		Util.Themable(label, "TextColor3", "Text")

		local description
		if hasDescription then
			description = Util.Text({
				Name = "Description",
				Text = config.Description,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Util.Theme.TextMuted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, sidePadding, 0, 27),
				Size = UDim2.new(labelWidth.Scale, labelWidth.Offset, 0, 16),
				Parent = frame,
			})
			Util.Themable(description, "TextColor3", "TextMuted")
		end

		-- Right-side control slot -----------------------------------------
		local right = Util.New("Frame", {
			Name = "Control",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -sidePadding, 0.5, 0),
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = frame,
		})

		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 8),
			Parent = right,
		})

		local row = {
			Frame = frame,
			Right = right,
			Label = label,
			Description = description,
			Height = height,
			Hovered = false,
		}

		function row.SetHover(self, value: boolean)
			setHover(value)
		end

		function row.SetLabel(self, text: string)
			label.Text = text
		end

		function row.SetDescription(self, text: string?)
			if description then
				description.Text = text or ""
			end
		end

		function row.SetTooltip(self, text: string)
			frame:SetAttribute("Tooltip", text)
		end

		if config.Clickable and config.OnClick then
			Util.OnClick(frame, function()
				Util.SafeCall(config.OnClick)
			end)
		end

		return row
	end

	return Row
end

Modules["Button"] = function()
	--[[
		Aurora UI  •  Button.luau
		------------------------------------------------------------------
		Two flavours, one implementation:
		  • compact  — sits on the right of a settings row
		  • block    — full-width call-to-action with gradient fill

		Styles: primary | secondary | ghost | danger
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")
	local Row = __req("Row")

	local Button = {}

	local STYLES = {
		primary = { Height = 34, Radius = 9 },
		secondary = { Height = 30, Radius = 8 },
		ghost = { Height = 30, Radius = 8 },
		danger = { Height = 30, Radius = 8 },
		block = { Height = 38, Radius = 10 },
	}

	--- Internal: build the visual shell of a button.
	local function buildShell(parent: Instance, config): (Frame, TextLabel, Frame?)
		local style = config.Style or "secondary"
		local metrics = STYLES[style] or STYLES.secondary
		local gradient = style == "primary" or style == "block"

		-- Template style decides how a primary button looks: gradient, flat
		-- accent, outlined accent, or a bordered block.
		local variant = Util.M("Button", "gradient")
		local primaryText = (gradient and variant == "outline") and Util.Theme.Accent or Util.Theme.AccentText

		local button = Util.New("Frame", {
			Name = "Button_" .. (config.Name or "Action"),
			BackgroundColor3 = Util.Theme.Surface,
			BackgroundTransparency = 0,
			AnchorPoint = config.AnchorPoint,
			Position = config.Position,
			Size = config.FullWidth and UDim2.new(1, 0, 0, metrics.Height)
				or UDim2.fromOffset(config.Width or 0, metrics.Height),
			AutomaticSize = (config.FullWidth and Enum.AutomaticSize.None) or Enum.AutomaticSize.X,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = parent,
		})
		Util.Corner(config.Radius or metrics.Radius, button)
		-- Content wrapper: keeps the sheen and ripple frames out of the list layout,
		-- otherwise a full-size decorative child would push the label off the button.
		local content = Util.New("Frame", {
			Name = "Content",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			ZIndex = button.ZIndex + 1,
			Parent = button,
		})
		Util.Padding({ X = 12 }, content)
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
			Parent = content,
		})

		-- Base colors -----------------------------------------------------
		if gradient then
			if variant == "gradient" then
				Util.Gradient(
					ColorSequence.new(Util.Theme.Accent, Util.Theme.Accent2),
					0,
					button
				)
				Util.Themable(button, "BackgroundColor3", "Accent")
			elseif variant == "solid" then
				Util.Themable(button, "BackgroundColor3", "Accent")
			elseif variant == "outline" then
				button.BackgroundTransparency = 1
				Util.Themable(button, "BackgroundColor3", "Accent")
				Util.Stroke(Util.Theme.Accent, 1.6, 0, button)
			elseif variant == "brutal" then
				Util.Themable(button, "BackgroundColor3", "Accent")
				Util.Stroke(Util.Theme.Text, 2, 0, button)
			end
		elseif style == "danger" then
			Util.Themable(button, "BackgroundColor3", "Surface")
			Util.Stroke(Util.Theme.Danger, 1, 0.55, button)
			button.BackgroundTransparency = 0.86
		elseif style == "ghost" then
			button.BackgroundTransparency = 1
			Util.Themable(button, "BackgroundColor3", "SurfaceHover")
		else
			Util.Themable(button, "BackgroundColor3", "Surface")
			Util.Stroke(Util.Theme.Stroke, 1, 0, button)
		end

		-- Hover sheen (style agnostic) ------------------------------------
		local sheen = Util.New("Frame", {
			Name = "Sheen",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			ZIndex = button.ZIndex + 2,
			Parent = button,
		})
		Util.Corner(config.Radius or metrics.Radius, sheen)

		button.MouseEnter:Connect(function()
			Util.Tween(sheen, { BackgroundTransparency = gradient and 0.88 or 0.94 }, "Fast")
		end)
		button.MouseLeave:Connect(function()
			Util.Tween(sheen, { BackgroundTransparency = 1 }, "Fast")
		end)

		-- Icon + label ----------------------------------------------------
		local icon
		if config.Icon then
			local iconColor
			if gradient then
				iconColor = primaryText
			elseif style == "danger" then
				iconColor = Util.Theme.Danger
			elseif style == "ghost" then
				iconColor = Util.Theme.TextMuted
			else
				iconColor = Util.Theme.Text
			end
			icon = Icons.Get(config.Icon, content, {
				Size = config.IconSize or 14,
				Color = iconColor,
				Mask = gradient and (variant == "outline" and Util.Theme.Surface or Util.Theme.Accent) or Util.Theme.Surface,
			})
			icon.ZIndex = button.ZIndex + 1
		end

		local label = Util.Text({
			Name = "Label",
			Text = config.Name or "Button",
			Font = Enum.Font.GothamMedium,
			TextSize = config.TextSize or 12,
			TextColor3 = gradient and primaryText
				or (style == "danger" and Util.Theme.Danger)
				or (style == "ghost" and Util.Theme.TextMuted)
				or Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(0, metrics.Height),
			AutomaticSize = Enum.AutomaticSize.X,
			ZIndex = button.ZIndex + 1,
			Parent = content,
		})
		if not gradient then
			Util.Themable(label, "TextColor3", style == "danger" and "Danger" or (style == "ghost" and "TextMuted" or "Text"))
		end

		return button, label, icon
	end

	--- Public constructor.
	function Button.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local container = parent
		local row
		if not config.FullWidth then
			row = Row.Create(parent, {
				Name = config.Name,
				Description = config.Description,
				Height = config.RowHeight,
			})
			container = row.Right
		end

		local style
		if config.FullWidth then
			style = config.Style or "block"
		else
			style = config.Style or "secondary"
		end
		local button, label, icon = buildShell(container, {
			Name = config.Name,
			Icon = config.Icon,
			Style = style,
			FullWidth = config.FullWidth,
			Width = config.Width,
			TextSize = config.TextSize,
			IconSize = config.IconSize,
		})

		local enabled = config.Enabled ~= false
		local armed = false
		local object = { Instance = button, Row = row, Label = label, Icon = icon }

		Util.Scale(button)
		local scale = button:FindFirstChildOfClass("UIScale")
		Util.Ripple(button, gradient and Color3.new(1, 1, 1) or Util.Theme.Text, 2.6)

		Util.OnClick(button, function()
			if not enabled or button:GetAttribute("Loading") then
				return
			end

			if config.Confirm and not armed then
				armed = true
				label.Text = config.ConfirmText or "Are you sure?"
				task.delay(2.4, function()
					if button.Parent and armed then
						armed = false
						label.Text = config.Name or "Button"
					end
				end)
				return
			end

			armed = false
			if config.Confirm then
				label.Text = config.Name or "Button"
			end

			Util.SafeCall(config.Callback)
			if window and config.Notify then
				window:Notify(config.Notify)
			end
		end)

		if config.Tooltip then
			button:SetAttribute("Tooltip", config.Tooltip)
		end

		function object.SetText(self, text: string)
			label.Text = text
		end

		function object.GetText(self): string
			return label.Text
		end

		function object.SetEnabled(self, value: boolean)
			enabled = value
			Util.Tween(button, { BackgroundTransparency = value and (gradient and 0 or (style == "ghost" and 1 or 0.86)) or 0.6 }, "Fast")
			Util.Tween(label, { TextTransparency = value and 0 or 0.5 }, "Fast")
			if icon then
				Util.Fade(icon, value and 0 or 0.45, "Fast")
			end
		end

		function object.SetLoading(self, value: boolean)
			button:SetAttribute("Loading", value)
			label.Text = value and (config.LoadingText or "Working…") or (config.Name or "Button")
		end

		function object.Destroy(self)
			if row then
				row.Frame:Destroy()
			else
				button:Destroy()
			end
		end

		return object
	end

	return Button
end

Modules["Toggle"] = function()
	--[[
		Aurora UI  •  Toggle.luau
		------------------------------------------------------------------
		Pill switch with a gradient fill, spring-animated knob and an
		optional description line. The entire row is clickable.
	--]]

	local Util = __req("Util")
	local Row = __req("Row")

	local Toggle = {}

	local TRACK_W, TRACK_H, KNOB = 46, 26, 20
	local PAD = (TRACK_H - KNOB) / 2

	function Toggle.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local row = Row.Create(parent, {
			Name = config.Name,
			Description = config.Description,
			Height = config.Height,
		})

		-- Track -----------------------------------------------------------
		local track = Util.New("Frame", {
			Name = "Track",
			BackgroundColor3 = Util.Theme.SurfaceActive,
			Size = UDim2.fromOffset(TRACK_W, TRACK_H),
			BorderSizePixel = 0,
			Parent = row.Right,
		})
		Util.Corner(999, track)
		Util.Stroke(Util.Theme.Stroke, 1, 0, track)

		local fill = Util.Gradient(
			ColorSequence.new(Util.Theme.Accent, Util.Theme.Accent2),
			0,
			track
		)
		fill.Enabled = false

		Util.Themable(track, "BackgroundColor3", function(palette)
			return track:GetAttribute("On") and palette.Accent or palette.SurfaceActive
		end)
		Util.Themable(fill, "Color", function(palette)
			return ColorSequence.new(palette.Accent, palette.Accent2)
		end)

		local stroke = track:FindFirstChildOfClass("UIStroke")
		if stroke then
			Util.Themable(stroke, "Color", function(palette)
				return track:GetAttribute("On") and palette.Accent or palette.Stroke
			end)
			Util.Themable(stroke, "Transparency", function(palette)
				return track:GetAttribute("On") and 1 or 0
			end)
		end

		-- Knob ------------------------------------------------------------
		local knob = Util.New("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, PAD, 0.5, 0),
			Size = UDim2.fromOffset(KNOB, KNOB),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.05,
			BorderSizePixel = 0,
			ZIndex = track.ZIndex + 1,
			Parent = track,
		})
		Util.Corner(999, knob)

		local knobHold = Util.New("Frame", {
			Name = "KnobGrip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = Util.Theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = knob,
		})
		Util.Corner(999, knobHold)

		-- State -----------------------------------------------------------
		local state = config.Default == true
		local enabled = config.Disabled ~= true
		local object = { Instance = row.Frame, Kind = "Toggle" }
		object.Value = state

		local function render(animated: boolean)
			track:SetAttribute("On", state)
			fill.Enabled = state
			knobHold.BackgroundColor3 = state and Util.Theme.AccentText or Util.Theme.TextDim
			local target = UDim2.new(0, state and (TRACK_W - KNOB - PAD) or PAD, 0.5, 0)

			if animated then
				Util.Tween(knob, { Position = target }, "Spring")
				Util.Tween(track, { BackgroundColor3 = state and Util.Theme.Accent or Util.Theme.SurfaceActive }, "Fast")
			else
				knob.Position = target
				track.BackgroundColor3 = state and Util.Theme.Accent or Util.Theme.SurfaceActive
			end
		end

		local function set(value: boolean, silent: boolean?)
			if not enabled then
				return
			end
			state = value and true or false
			object.Value = state
			render(true)
			if not silent then
				Util.SafeCall(config.Callback, state)
				if window then
					window:_flash(row.Frame)
				end
			end
		end

		render(false)

		Util.OnClick(row.Frame, function()
			set(not state)
		end)

		track.MouseEnter:Connect(function()
			Util.Tween(knob, { BackgroundTransparency = 0 }, "Fast")
		end)

		if config.Tooltip then
			row.Frame:SetAttribute("Tooltip", config.Tooltip)
		end

		function object.Get(self): boolean
			return state
		end

		function object.Set(self, value: boolean, silent: boolean?)
			set(value, silent)
		end

		function object.Toggle(self)
			set(not state)
		end

		function object.SetEnabled(self, value: boolean)
			enabled = value
			Util.Tween(row.Frame, { BackgroundTransparency = value and 1 or 0.72 }, "Fast")
		end

		function object.Destroy(self)
			row.Frame:Destroy()
		end

		return object
	end

	return Toggle
end

Modules["Slider"] = function()
	--[[
		Aurora UI  •  Slider.luau
		------------------------------------------------------------------
		Full-width gradient slider with draggable knob, live value pill and
		step snapping. Designed as a two-line row so long labels never get
		squeezed by the control.
	--]]

	local Util = __req("Util")
	local UserInputService = game:GetService("UserInputService")

	local Slider = {}

	function Slider.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local min = config.Min or 0
		local max = config.Max or 100
		local step = config.Step or 1
		local decimals = config.Decimals or (step < 1 and 2 or 0)
		local suffix = config.Suffix or ""
		local prefix = config.Prefix or ""
		local hasDescription = config.Description ~= nil and config.Description ~= ""
		local height = config.Height or (hasDescription and 68 or 54)

		local value = math.clamp(config.Default or min, min, max)
		local dragging = false
		local object = {}

		-- Shell -----------------------------------------------------------
		local frame = Util.New("Frame", {
			Name = "Slider_" .. (config.Name or "Value"),
			BackgroundColor3 = Util.Theme.Surface,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, height),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(10, frame)

		local hovered = false
		Util.Themable(frame, "BackgroundColor3", function(palette)
			return hovered and palette.SurfaceHover or palette.Surface
		end)

		frame.MouseEnter:Connect(function()
			hovered = true
			Util.Tween(frame, { BackgroundTransparency = 0.35 }, "Fast")
		end)
		frame.MouseLeave:Connect(function()
			hovered = false
			if not dragging then
				Util.Tween(frame, { BackgroundTransparency = 1 }, "Fast")
			end
		end)

		local label = Util.Text({
			Name = "Label",
			Text = config.Name or "",
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = Util.Theme.Text,
			Position = UDim2.new(0, 12, 0, 8),
			Size = UDim2.new(1, -110, 0, 17),
			Parent = frame,
		})
		Util.Themable(label, "TextColor3", "Text")

		local description
		if hasDescription then
			description = Util.Text({
				Name = "Description",
				Text = config.Description,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Util.Theme.TextMuted,
				Position = UDim2.new(0, 12, 0, 25),
				Size = UDim2.new(1, -110, 0, 15),
				Parent = frame,
			})
			Util.Themable(description, "TextColor3", "TextMuted")
		end

		-- Value pill ------------------------------------------------------
		local valuePill = Util.New("Frame", {
			Name = "ValuePill",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 6),
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Util.Theme.AccentSoft,
			BorderSizePixel = 0,
			Parent = frame,
		})
		Util.Corner(6, valuePill)
		Util.Padding({ X = 8 }, valuePill)
		Util.Themable(valuePill, "BackgroundColor3", "AccentSoft")

		local valueLabel = Util.Text({
			Name = "Value",
			Text = "0",
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Util.Theme.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = valuePill,
		})
		Util.Themable(valueLabel, "TextColor3", "Accent")

		-- Track -----------------------------------------------------------
		local trackY = hasDescription and 47 or 35

		local hitbox = Util.New("Frame", {
			Name = "Hitbox",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 12, 0, trackY - 8),
			Size = UDim2.new(1, -24, 0, 22),
			Parent = frame,
		})

		local track = Util.New("Frame", {
			Name = "Track",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(1, 0, 0, 6),
			BackgroundColor3 = Util.Theme.SurfaceActive,
			BorderSizePixel = 0,
			Parent = hitbox,
		})
		Util.Corner(999, track)
		Util.Themable(track, "BackgroundColor3", "SurfaceActive")

		local fillGradient
		local fill = Util.New("Frame", {
			Name = "Fill",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Util.Theme.Accent,
			BorderSizePixel = 0,
			Parent = track,
		})
		Util.Corner(999, fill)
		fillGradient = Util.Gradient(ColorSequence.new(Util.Theme.Accent, Util.Theme.Accent2), 0, fill)
		Util.Themable(fill, "BackgroundColor3", "Accent")
		Util.Themable(fillGradient, "Color", function(palette)
			return ColorSequence.new(palette.Accent, palette.Accent2)
		end)

		local knob = Util.New("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = track.ZIndex + 2,
			Parent = track,
		})
		Util.Corner(999, knob)
		local knobStroke = Util.Stroke(Util.Theme.Accent, 2, 0, knob)

		local knobHalo = Util.New("Frame", {
			Name = "Halo",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Util.Theme.Accent,
			BackgroundTransparency = 0.75,
			BorderSizePixel = 0,
			ZIndex = knob.ZIndex - 1,
			Parent = knob,
		})
		Util.Corner(999, knobHalo)
		knobHalo.Size = UDim2.fromOffset(26, 26)
		knobHalo.BackgroundTransparency = 0.86
		Util.Themable(knobHalo, "BackgroundColor3", "Accent")
		Util.Themable(knobStroke, "Color", "Accent")

		-- Formatting ------------------------------------------------------
		local function format(current: number): string
			if config.Format then
				local ok, text = pcall(config.Format, current)
				if ok then
					return tostring(text)
				end
			end
			return prefix .. Util.TrimNumber(current, decimals) .. suffix
		end

		local function alphaOf(current: number): number
			if max == min then
				return 0
			end
			return (current - min) / (max - min)
		end

		local function render()
			local alpha = alphaOf(value)
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueLabel.Text = format(value)
		end

		local function commit(nextValue: number, fireCallback: boolean?)
			local snapped = nextValue
			if step and step > 0 then
				snapped = math.floor((nextValue - min) / step + 0.5) * step + min
			end
			snapped = math.clamp(Util.Round(snapped, decimals + 2), min, max)
			if snapped == value and fireCallback ~= true then
				return
			end
			value = snapped
			object.Value = value
			render()
			if fireCallback ~= false then
				Util.SafeCall(config.Callback, value)
			end
		end

		local function setFromX(x: number)
			local left = track.AbsolutePosition.X
			local width = math.max(track.AbsoluteSize.X, 1)
			local alpha = math.clamp((x - left) / width, 0, 1)
			commit(min + (max - min) * alpha, true)
		end

		-- Input -----------------------------------------------------------
		local function endDrag()
			if not dragging then
				return
			end
			dragging = false
			Util.Tween(frame, { BackgroundTransparency = hovered and 0.35 or 1 }, "Fast")
			Util.Tween(knob, { Size = UDim2.fromOffset(14, 14) }, "Spring")
			Util.Tween(knobHalo, { Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 0.86 }, "Fast")
			Util.SafeCall(config.OnRelease, value)
		end

		hitbox.InputBegan:Connect(function(input)
			if
				input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end
			dragging = true
			Util.Tween(knob, { Size = UDim2.fromOffset(17, 17) }, "Spring")
			Util.Tween(knobHalo, { Size = UDim2.fromOffset(34, 34), BackgroundTransparency = 0.72 }, "Fast")
			setFromX(input.Position.X)
		end)

		UserInputService.InputChanged:Connect(function(input)
			if not dragging then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				setFromX(input.Position.X)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				endDrag()
			end
		end)

		-- Scroll wheel nudge while hovering -------------------------------
		hitbox.MouseWheelForward:Connect(function()
			if hovered then
				commit(value + (step or 1), true)
			end
		end)
		hitbox.MouseWheelBackward:Connect(function()
			if hovered then
				commit(value - (step or 1), true)
			end
		end)

		render()

		object.Instance = frame
		object.Kind = "Slider"
		object.Value = value

		function object.Get(self): number
			return value
		end

		function object.Set(self, nextValue: number, silent: boolean?)
			commit(nextValue, not silent)
		end

		function object.SetRange(self, nextMin: number, nextMax: number)
			min, max = nextMin, nextMax
			commit(value, false)
		end

		if config.Tooltip then
			frame:SetAttribute("Tooltip", config.Tooltip)
		end

		return object
	end

	return Slider
end

Modules["Dropdown"] = function()
	--[[
		Aurora UI  •  Dropdown.luau
		------------------------------------------------------------------
		Searchable, animated select menu. Supports single and multi select,
		opens upward when there isn't room below, and renders on the window
		overlay so it is never clipped by the scrolling page.
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")
	local Row = __req("Row")
	local UserInputService = game:GetService("UserInputService")

	local Dropdown = {}

	function Dropdown.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local options = {}
		for index, option in ipairs(config.Options or {}) do
			if type(option) == "table" then
				table.insert(options, { Value = option.Value or option[1], Label = option.Label or option[1] })
			else
				table.insert(options, { Value = option, Label = tostring(option) })
			end
		end

		local multi = config.Multi == true
		local selected = {}

		local function findOption(value)
			for _, option in ipairs(options) do
				if option.Value == value then
					return option
				end
			end
			return nil
		end

		if multi then
			for _, value in ipairs(config.Default or {}) do
				table.insert(selected, value)
			end
		else
			selected[1] = config.Default ~= nil and config.Default or (options[1] and options[1].Value)
		end

		local row = Row.Create(parent, {
			Name = config.Name,
			Description = config.Description,
			Height = config.Height,
		})

		-- Trigger ---------------------------------------------------------
		local trigger = Util.New("Frame", {
			Name = "Trigger",
			BackgroundColor3 = Util.Theme.Surface,
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			BorderSizePixel = 0,
			Parent = row.Right,
		})
		Util.Corner(8, trigger)
		Util.Stroke(Util.Theme.Stroke, 1, 0, trigger)
		Util.Padding({ X = 10 }, trigger)
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			Parent = trigger,
		})

		local triggerLabel = Util.Text({
			Name = "Value",
			Text = "Select",
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = Util.Theme.Text,
			Size = UDim2.fromOffset(112, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = trigger,
		})
		Util.Themable(triggerLabel, "TextColor3", "Text")

		local chevron = Icons.Get("chevronDown", trigger, {
			Size = 12,
			Color = Util.Theme.TextMuted,
			Mask = Util.Theme.Surface,
		})
		Util.Themable(chevron, "BackgroundColor3", "Surface")

		local triggerStroke = trigger:FindFirstChildOfClass("UIStroke")
		local hovered = false

		trigger.MouseEnter:Connect(function()
			hovered = true
			Util.Tween(trigger, { BackgroundColor3 = Util.Theme.SurfaceHover }, "Fast")
			if triggerStroke then
				Util.Tween(triggerStroke, { Color = Util.Theme.StrokeBright }, "Fast")
			end
		end)
		trigger.MouseLeave:Connect(function()
			hovered = false
			Util.Tween(trigger, { BackgroundColor3 = Util.Theme.Surface }, "Fast")
			if triggerStroke then
				Util.Tween(triggerStroke, { Color = Util.Theme.Stroke }, "Fast")
			end
		end)

		-- State -----------------------------------------------------------
		local object = { Instance = row.Frame, Kind = "Dropdown" }
		local popup, clickcatcher
		local isOpen = false

		local function summary(): string
			if multi then
				if #selected == 0 then
					return config.Placeholder or "None"
				elseif #selected == 1 then
					local option = findOption(selected[1])
					return option and option.Label or tostring(selected[1])
				end
				return string.format("%d selected", #selected)
			end
			local option = findOption(selected[1])
			return option and option.Label or (config.Placeholder or "Select")
		end

		local function refreshTrigger()
			triggerLabel.Text = summary()
		end

		local function isSelected(value): boolean
			for _, entry in ipairs(selected) do
				if entry == value then
					return true
				end
			end
			return false
		end

		local function close()
			if not isOpen then
				return
			end
			isOpen = false
			row:SetHover(false)

			local dying = popup
			popup = nil
			if clickcatcher then
				clickcatcher:Destroy()
				clickcatcher = nil
			end
			if dying then
				local scaleInstance = dying:FindFirstChildOfClass("UIScale")
				if scaleInstance then
					Util.Tween(scaleInstance, { Scale = 0.96 }, "Fast")
				end
				Util.Tween(dying, { BackgroundTransparency = 1 }, "Fast")
				for _, descendant in ipairs(dying:GetDescendants()) do
					if descendant:IsA("TextLabel") then
						Util.Tween(descendant, { TextTransparency = 1 }, "Fast")
					elseif descendant:IsA("Frame") then
						Util.Tween(descendant, { BackgroundTransparency = 1 }, "Fast")
					elseif descendant:IsA("UIStroke") then
						Util.Tween(descendant, { Transparency = 1 }, "Fast")
					end
				end
				task.delay(0.16, function()
					if dying then
						dying:Destroy()
					end
				end)
			end
		end

		local function select(value)
			if multi then
				if isSelected(value) then
					for index, entry in ipairs(selected) do
						if entry == value then
							table.remove(selected, index)
							break
						end
					end
				else
					if config.Max and #selected >= config.Max then
						return
					end
					table.insert(selected, value)
				end
				refreshTrigger()
				Util.SafeCall(config.Callback, table.clone(selected))
			else
				selected = { value }
				refreshTrigger()
				Util.SafeCall(config.Callback, value)
				close()
			end
		end

		-- Popup -----------------------------------------------------------
		local function buildPopup()
			local overlay = window:_overlay()
			local width = math.max(trigger.AbsoluteSize.X, config.MenuWidth or 180)

			clickcatcher = Util.New("Frame", {
				Name = "DropdownCatcher",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 900,
				Parent = overlay,
			})
			Util.OnClick(clickcatcher, close)

			popup = Util.New("Frame", {
				Name = "DropdownMenu",
				BackgroundColor3 = Util.Theme.Elevated,
				Size = UDim2.fromOffset(width, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				ZIndex = 901,
				Parent = overlay,
			})
			Util.Corner(10, popup)
			Util.Stroke(Util.Theme.StrokeBright, 1, 0.4, popup)
			Util.Padding({ Y = 6, X = 6 }, popup)
			Util.Themable(popup, "BackgroundColor3", "Elevated")

			local scaleInstance = Util.Scale(popup)
			scaleInstance.Scale = 0.96
			Util.Tween(scaleInstance, { Scale = 1 }, "Fast")

			local content = Util.New("Frame", {
				Name = "Content",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = popup,
			})
			Util.List({ Padding = UDim.new(0, 2), Parent = content })

			-- Optional search ---------------------------------------------
			local query = ""
			local optionsHolder = content

			if #options > 6 then
				local searchBox = Util.New("Frame", {
					Name = "Search",
					BackgroundColor3 = Util.Theme.Surface,
					Size = UDim2.new(1, 0, 0, 30),
					BorderSizePixel = 0,
					LayoutOrder = -1,
					Parent = content,
				})
				Util.Corner(7, searchBox)
				Util.Padding({ X = 8 }, searchBox)
				Util.Themable(searchBox, "BackgroundColor3", "Surface")

				local searchIcon = Icons.Get("search", searchBox, {
					Size = 12,
					Color = Util.Theme.TextDim,
					Mask = Util.Theme.Surface,
				})
				searchIcon.Position = UDim2.fromOffset(0, 9)

				local input = Util.New("TextBox", {
					Name = "Input",
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(20, 0),
					Size = UDim2.new(1, -20, 1, 0),
					Font = Enum.Font.Gotham,
					TextSize = 12,
					PlaceholderText = "Search…",
					PlaceholderColor3 = Util.Theme.TextDim,
					TextColor3 = Util.Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false,
					Text = "",
					Parent = searchBox,
				})
				Util.Themable(input, "TextColor3", "Text")
				Util.Themable(input, "PlaceholderColor3", "TextDim")

				optionsHolder = Util.New("Frame", {
					Name = "Options",
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Parent = content,
				})
				Util.List({ Padding = UDim.new(0, 2), Parent = optionsHolder })

				input:GetPropertyChangedSignal("Text"):Connect(function()
					query = string.lower(input.Text)
					for _, item in ipairs(optionsHolder:GetChildren()) do
						if item:IsA("Frame") then
							local haystack = string.lower(item:GetAttribute("Label") or "")
							item.Visible = query == "" or string.find(haystack, query, 1, true) ~= nil
						end
					end
				end)
			end

			local list = optionsHolder
			for index, option in ipairs(options) do
				local item = Util.New("Frame", {
					Name = "Option_" .. tostring(option.Value),
					BackgroundColor3 = Util.Theme.Surface,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 30),
					BorderSizePixel = 0,
					LayoutOrder = index,
					Parent = list,
				})
				Util.Corner(7, item)
				item:SetAttribute("Label", option.Label)

				local text = Util.Text({
					Name = "Label",
					Text = option.Label,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextColor3 = Util.Theme.Text,
					Position = UDim2.fromOffset(8, 0),
					Size = UDim2.new(1, -30, 1, 0),
					Parent = item,
				})
				Util.Themable(text, "TextColor3", "Text")

				if isSelected(option.Value) then
					local check = Icons.Get("check", item, {
						Size = 12,
						Color = Util.Theme.Accent,
						Mask = Util.Theme.Surface,
					})
					check.AnchorPoint = Vector2.new(1, 0.5)
					check.Position = UDim2.new(1, -8, 0.5, 0)
				end

				item.MouseEnter:Connect(function()
					if item.Visible then
						Util.Tween(item, { BackgroundTransparency = 0, BackgroundColor3 = Util.Theme.SurfaceHover }, "Fast")
					end
				end)
				item.MouseLeave:Connect(function()
					Util.Tween(item, { BackgroundTransparency = 1 }, "Fast")
				end)
				Util.OnClick(item, function()
					select(option.Value)
				end)
			end

			-- Position: below the trigger, or above when space is tight -----
			local overlayY = overlay.AbsolutePosition.Y
			local overlayHeight = overlay.AbsoluteSize.Y
			local triggerTop = trigger.AbsolutePosition.Y - overlayY
			local triggerBottom = triggerTop + trigger.AbsoluteSize.Y
			local estimated = math.min(#options * 32 + (#options > 6 and 36 or 0) + 12, 260)
			local opensUp = triggerBottom + estimated > overlayHeight - 8

			local x = math.clamp(
				trigger.AbsolutePosition.X - overlay.AbsolutePosition.X + trigger.AbsoluteSize.X - width,
				8,
				math.max(8, overlay.AbsoluteSize.X - width - 8)
			)

			popup.Position = UDim2.fromOffset(
				x,
				opensUp and (triggerTop - estimated - 6) or (triggerBottom + 6)
			)
			if opensUp then
				popup.AnchorPoint = Vector2.new(0, 0)
			end
		end

		local function open()
			if isOpen then
				return
			end
			isOpen = true
			row:SetHover(true)
			buildPopup()
		end

		Util.OnClick(trigger, function()
			if isOpen then
				close()
			else
				open()
			end
		end)
		trigger.MouseEnter:Connect(function()
			Util.Tween(chevron, { Rotation = 180 }, "Fast")
		end)
		trigger.MouseLeave:Connect(function()
			if not isOpen then
				Util.Tween(chevron, { Rotation = 0 }, "Fast")
			end
		end)

		refreshTrigger()

		object.Value = multi and selected or selected[1]

		function object.Get(self)
			if multi then
				return table.clone(selected)
			end
			return selected[1]
		end

		function object.Set(self, value, silent: boolean?)
			if multi and type(value) == "table" then
				selected = table.clone(value)
			else
				selected = { value }
			end
			refreshTrigger()
			if not silent then
				Util.SafeCall(config.Callback, object:Get())
			end
		end

		function object.SetOptions(self, nextOptions)
			options = nextOptions
			refreshTrigger()
		end

		function object.Destroy(self)
			close()
			row.Frame:Destroy()
		end

		return object
	end

	return Dropdown
end

Modules["TextBox"] = function()
	--[[
		Aurora UI  •  TextBox.luau
		------------------------------------------------------------------
		Text input with placeholder, optional leading icon, clear button,
		numeric filtering, validation hook and focus ring animation.
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")
	local Row = __req("Row")

	local TextBox = {}

	function TextBox.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local row = Row.Create(parent, {
			Name = config.Name,
			Description = config.Description,
			Height = config.Height or (config.FullWidth and 56 or nil),
		})

		local width = config.Width or 180
		local height = config.Height or 30

		local wrapper = Util.New("Frame", {
			Name = "Input",
			BackgroundColor3 = Util.Theme.Surface,
			Size = config.FullWidth and UDim2.new(1, 0, 0, 32) or UDim2.fromOffset(width, height),
			BorderSizePixel = 0,
			Parent = row.Right,
		})
		Util.Corner(8, wrapper)
		local stroke = Util.Stroke(Util.Theme.Stroke, 1, 0, wrapper)
		Util.Padding({ X = config.Icon and 30 or 10 }, wrapper)
		Util.Themable(wrapper, "BackgroundColor3", "Surface")
		Util.Themable(stroke, "Color", "Stroke")

		if config.Icon then
			local icon = Icons.Get(config.Icon, wrapper, {
				Size = 13,
				Color = Util.Theme.TextDim,
				Mask = Util.Theme.Surface,
			})
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, -22, 0.5, 0)
			Util.Themable(icon, "BackgroundColor3", "Surface")
		end

		local input = Util.New("TextBox", {
			Name = "Field",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, config.ClearButton and -18 or 0, 1, 0),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			Text = config.Default or "",
			PlaceholderText = config.Placeholder or "",
			PlaceholderColor3 = Util.Theme.TextDim,
			TextColor3 = Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			MultiLine = false,
			Parent = wrapper,
		})
		Util.Themable(input, "TextColor3", "Text")
		Util.Themable(input, "PlaceholderColor3", "TextDim")

		if config.MaxLength then
			input:GetPropertyChangedSignal("Text"):Connect(function()
				if #input.Text > config.MaxLength then
					input.Text = string.sub(input.Text, 1, config.MaxLength)
				end
			end)
		end

		-- Clear button ----------------------------------------------------
		local clearIcon
		if config.ClearButton ~= false then
			clearIcon = Icons.Get("close", wrapper, {
				Size = 10,
				Color = Util.Theme.TextDim,
				Mask = Util.Theme.Surface,
			})
			clearIcon.AnchorPoint = Vector2.new(1, 0.5)
			clearIcon.Position = UDim2.new(1, 2, 0.5, 0)
			clearIcon.BackgroundTransparency = 1
			Util.New("Frame", {
				Name = "Hitbox",
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(20, 20),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Parent = clearIcon,
			})
			local function updateVisibility()
				clearIcon.Visible = input.Text ~= ""
			end
			updateVisibility()
			input:GetPropertyChangedSignal("Text"):Connect(updateVisibility)
			Util.OnClick(clearIcon:FindFirstChildOfClass("Frame") or clearIcon, function()
				input.Text = ""
				Util.SafeCall(config.Callback, "")
			end)
		end

		-- Focus ring ------------------------------------------------------
		local focused = false
		input.Focused:Connect(function()
			focused = true
			Util.Tween(stroke, { Color = Util.Theme.Accent, Thickness = 1.5, Transparency = 0 }, "Fast")
			Util.Tween(wrapper, { BackgroundColor3 = Util.Theme.SurfaceHover }, "Fast")
		end)
		input.FocusLost:Connect(function(enterPressed)
			focused = false
			Util.Tween(stroke, { Color = Util.Theme.Stroke, Thickness = 1 }, "Fast")
			Util.Tween(wrapper, { BackgroundColor3 = Util.Theme.Surface }, "Fast")

			if config.Validate then
				local ok, valid, message = pcall(config.Validate, input.Text)
				if ok and valid == false then
					local original = input.Text
					Util.Tween(wrapper, { BackgroundColor3 = Util.Theme.Danger }, "Fast")
					Util.Tween(stroke, { Color = Util.Theme.Danger }, "Fast")
					task.delay(0.8, function()
						if wrapper.Parent then
							Util.Tween(wrapper, { BackgroundColor3 = Util.Theme.Surface }, "Fast")
							Util.Tween(stroke, { Color = Util.Theme.Stroke }, "Fast")
						end
					end)
					if window and message then
						window:Notify({ Title = "Invalid input", Body = message, Type = "error" })
					end
					input.Text = config.RevertOnInvalid and original or input.Text
					return
				end
			end

			Util.SafeCall(config.Callback, input.Text)
			if enterPressed then
				Util.SafeCall(config.OnEnter, input.Text)
			end
		end)

		-- Numeric guard ---------------------------------------------------
		if config.Numeric then
			local allowed = config.AllowNegative and "^[-%d%.]*$" or "^[%d%.]*$"
			input:GetPropertyChangedSignal("Text"):Connect(function()
				if string.match(input.Text, allowed) == nil then
					input.Text = string.gsub(input.Text, "[^%d%.%-]", "")
				end
			end)
		end

		local object = { Instance = row.Frame, Kind = "TextBox", Input = input }

		function object.Get(self): string
			return input.Text
		end

		function object.Set(self, text: string, silent: boolean?)
			input.Text = text or ""
			if not silent then
				Util.SafeCall(config.Callback, input.Text)
			end
		end

		function object.Focus(self)
			input:CaptureFocus()
		end

		function object.SetEnabled(self, value: boolean)
			input.TextEditable = value
			Util.Tween(wrapper, { BackgroundTransparency = value and 0 or 0.5 }, "Fast")
			Util.Tween(input, { TextTransparency = value and 0 or 0.45 }, "Fast")
		end

		return object
	end

	return TextBox
end

Modules["Keybind"] = function()
	--[[
		Aurora UI  •  Keybind.luau
		------------------------------------------------------------------
		Click to record a keyboard or mouse binding (with modifier display),
		press Backspace to clear and Escape to cancel. Registers a global
		listener so `Callback` fires whenever the binding is pressed.

		Common uses: binding a menu hotkey, a screenshot key, or an
		accessibility shortcut.
	--]]

	local Util = __req("Util")
	local Row = __req("Row")
	local UserInputService = game:GetService("UserInputService")

	local Keybind = {}

	function Keybind.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local row = Row.Create(parent, {
			Name = config.Name,
			Description = config.Description,
			Height = config.Height,
		})

		local pill = Util.New("Frame", {
			Name = "KeyPill",
			BackgroundColor3 = Util.Theme.Surface,
			Size = UDim2.fromOffset(config.Width or 96, 28),
			BorderSizePixel = 0,
			Parent = row.Right,
		})
		Util.Corner(7, pill)
		local stroke = Util.Stroke(Util.Theme.Stroke, 1, 0, pill)
		Util.Themable(pill, "BackgroundColor3", "Surface")
		Util.Themable(stroke, "Color", "Stroke")

		local label = Util.Text({
			Name = "KeyLabel",
			Text = "None",
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Util.Theme.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = pill,
		})
		Util.Themable(label, "TextColor3", "TextMuted")

		local key: Enum.KeyCode? = config.Default
		local mouseButton: Enum.UserInputType? = config.MouseButton
		local listening = false
		local enabled = config.Disabled ~= true
		local object = { Instance = row.Frame, Kind = "Keybind" }

		local function comboLabel(): string
			if mouseButton then
				if mouseButton == Enum.UserInputType.MouseButton1 then
					return "Mouse Left"
				elseif mouseButton == Enum.UserInputType.MouseButton2 then
					return "Mouse Right"
				elseif mouseButton == Enum.UserInputType.MouseButton3 then
					return "Mouse Middle"
				end
				return "Mouse"
			end
			if not key then
				return config.Placeholder or "None"
			end
			return Util.KeyLabel(key, {
				LeftControl = config.Modifiers and config.Modifiers.Control,
				LeftShift = config.Modifiers and config.Modifiers.Shift,
				LeftAlt = config.Modifiers and config.Modifiers.Alt,
			})
		end

		local function render()
			label.Text = listening and "Press a key…" or comboLabel()
			label.TextColor3 = listening and Util.Theme.Accent or Util.Theme.TextMuted
		end

		local connection
		local function stopListening()
			listening = false
			if connection then
				connection:Disconnect()
				connection = nil
			end
			Util.Tween(pill, { BackgroundColor3 = Util.Theme.Surface }, "Fast")
			Util.Tween(stroke, { Color = Util.Theme.Stroke, Transparency = 0 }, "Fast")
			render()
		end

		local function startListening()
			if not enabled or listening then
				return
			end
			listening = true
			render()
			Util.Tween(pill, { BackgroundColor3 = Util.Theme.AccentSoft }, "Fast")
			Util.Tween(stroke, { Color = Util.Theme.Accent, Transparency = 0 }, "Fast")

			connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if not listening then
					return
				end
				if gameProcessed then
					return
				end

				if input.KeyCode == Enum.KeyCode.Escape then
					stopListening()
					return
				elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
					key, mouseButton = nil, nil
					stopListening()
					Util.SafeCall(config.Callback, nil)
					return
				elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
					mouseButton, key = Enum.UserInputType.MouseButton1, nil
				elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
					mouseButton, key = Enum.UserInputType.MouseButton2, nil
				elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
					mouseButton, key = Enum.UserInputType.MouseButton3, nil
				elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
					key, mouseButton = input.KeyCode, nil
					config.Modifiers = {
						Control = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
						Shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
						Alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
					}
				else
					return
				end

				stopListening()
				Util.SafeCall(config.Callback, key, mouseButton, config.Modifiers)
			end)
		end

		Util.OnClick(pill, startListening)
		Util.OnClick(row.Frame, startListening)

		-- Global trigger ---------------------------------------------------
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed or listening or not enabled then
				return
			end
			if config.RequireNoModifiers ~= false and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
				return
			end

			local pressed = false
			if mouseButton and input.UserInputType == mouseButton then
				pressed = true
			elseif key and input.KeyCode == key then
				pressed = true
					and (not config.Modifiers or (
						(not config.Modifiers.Control or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl))
						and (not config.Modifiers.Shift or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))
						and (not config.Modifiers.Alt or UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt))
					))
			end

			if pressed then
				Util.SafeCall(config.OnPressed)
			end
		end)

		render()

		function object.Get(self): (Enum.KeyCode?, Enum.UserInputType?)
			return key, mouseButton
		end

		function object.Set(self, nextKey: Enum.KeyCode?, nextButton: Enum.UserInputType?, silent: boolean?)
			key, mouseButton = nextKey, nextButton
			render()
			if not silent then
				Util.SafeCall(config.Callback, key, mouseButton)
			end
		end

		function object.SetEnabled(self, value: boolean)
			enabled = value
			Util.Tween(row.Frame, { BackgroundTransparency = value and 1 or 0.6 }, "Fast")
		end

		function object.Destroy(self)
			stopListening()
			row.Frame:Destroy()
		end

		return object
	end

	return Keybind
end

Modules["ColorPicker"] = function()
	--[[
		Aurora UI  •  ColorPicker.luau
		------------------------------------------------------------------
		Swatch trigger + floating picker with:
		  • saturation / value area
		  • hue strip
		  • live hex field
		  • preset palette
		Fires Callback(Color3) live while dragging.
	--]]

	local Util = __req("Util")
	local Row = __req("Row")
	local UserInputService = game:GetService("UserInputService")

	local ColorPicker = {}

	local PRESETS = {
		"#7C5CFF", "#22D3EE", "#34D399", "#FBBF24",
		"#FB7185", "#F472B6", "#60A5FA", "#E5E7EB",
	}

	local function hueSequence(): ColorSequence
		local keys = {}
		for index = 0, 6 do
			table.insert(keys, ColorSequenceKeypoint.new(index / 6, Color3.fromHSV(index / 6, 1, 1)))
		end
		return ColorSequence.new(keys)
	end

	function ColorPicker.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local h, s, v = Color3.toHSV(config.Default or Color3.fromHex("#7C5CFF"))
		local color = Color3.fromHSV(h, s, v)

		local row = Row.Create(parent, {
			Name = config.Name,
			Description = config.Description,
			Height = config.Height,
		})

		-- Trigger ---------------------------------------------------------
		local trigger = Util.New("Frame", {
			Name = "Trigger",
			BackgroundColor3 = Util.Theme.Surface,
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			BorderSizePixel = 0,
			Parent = row.Right,
		})
		Util.Corner(7, trigger)
		Util.Stroke(Util.Theme.Stroke, 1, 0, trigger)
		Util.Padding({ X = 8 }, trigger)
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
			Parent = trigger,
		})
		Util.Themable(trigger, "BackgroundColor3", "Surface")

		local swatch = Util.New("Frame", {
			Name = "Swatch",
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(16, 16),
			BorderSizePixel = 0,
			Parent = trigger,
		})
		Util.Corner(5, swatch)
		Util.Stroke(Color3.new(0, 0, 0), 1, 0.7, swatch)

		local hexLabel = Util.Text({
			Name = "Hex",
			Text = "#" .. Util.ToHex(color),
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Util.Theme.Text,
			Size = UDim2.fromOffset(60, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = trigger,
		})
		Util.Themable(hexLabel, "TextColor3", "Text")

		local object = { Instance = row.Frame, Kind = "ColorPicker" }
		local popup, catcher, isOpen = nil, nil, false
		local close

		local function renderTrigger()
			swatch.BackgroundColor3 = color
			hexLabel.Text = "#" .. Util.ToHex(color)
			object.Value = color
		end

		-- Picker ----------------------------------------------------------
		local function build()
			local overlay = window:_overlay()
			local width = 236

			catcher = Util.New("Frame", {
				Name = "ColorCatcher",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 900,
				Parent = overlay,
			})

			popup = Util.New("Frame", {
				Name = "ColorPicker",
				BackgroundColor3 = Util.Theme.Elevated,
				Size = UDim2.fromOffset(width, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BorderSizePixel = 0,
				ZIndex = 901,
				Parent = overlay,
			})
			Util.Corner(12, popup)
			Util.Stroke(Util.Theme.StrokeBright, 1, 0.4, popup)
			Util.Padding(10, popup)
			Util.List({ Padding = UDim.new(0, 8), Parent = popup })
			Util.Themable(popup, "BackgroundColor3", "Elevated")

			-- Saturation / value area -------------------------------------
			local sv = Util.New("Frame", {
				Name = "SV",
				BackgroundColor3 = Color3.fromHSV(h, 1, 1),
				Size = UDim2.new(1, 0, 0, 108),
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Parent = popup,
			})
			Util.Corner(8, sv)

			Util.Gradient(
				ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)),
				0,
				sv
			).Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			})

			local shade = Util.New("Frame", {
				Name = "Shade",
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0,
				Size = UDim2.fromScale(1, 1),
				BorderSizePixel = 0,
				Parent = sv,
			})
			Util.Corner(8, shade)
			Util.Gradient(
				ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)),
				90,
				shade
			).Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			})

			local cursor = Util.New("Frame", {
				Name = "Cursor",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = sv,
			})
			Util.Corner(999, cursor)
			Util.Stroke(Color3.new(1, 1, 1), 2, 0, cursor)

			-- Hue strip ----------------------------------------------------
			local hueStrip = Util.New("Frame", {
				Name = "Hue",
				BackgroundColor3 = Color3.new(1, 1, 1),
				Size = UDim2.new(1, 0, 0, 12),
				BorderSizePixel = 0,
				Parent = popup,
			})
			Util.Corner(999, hueStrip)
			Util.Gradient(hueSequence(), 0, hueStrip)

			local hueKnob = Util.New("Frame", {
				Name = "HueKnob",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(h, 0, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = hueStrip,
			})
			Util.Corner(999, hueKnob)
			Util.Stroke(Color3.new(0, 0, 0), 1, 0.6, hueKnob)

			-- Hex row ------------------------------------------------------
			local bottom = Util.New("Frame", {
				Name = "Bottom",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 30),
				Parent = popup,
			})
			Util.List({
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 8),
				Parent = bottom,
			})

			local field = Util.New("Frame", {
				Name = "HexField",
				BackgroundColor3 = Util.Theme.Surface,
				Size = UDim2.new(1, -108, 1, 0),
				BorderSizePixel = 0,
				Parent = bottom,
			})
			Util.Corner(7, field)
			Util.Padding({ X = 8 }, field)
			Util.Themable(field, "BackgroundColor3", "Surface")

			local hexInput = Util.New("TextBox", {
				Name = "Hex",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Font = Enum.Font.Code,
				TextSize = 12,
				Text = "#" .. Util.ToHex(color),
				TextColor3 = Util.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Parent = field,
			})
			Util.Themable(hexInput, "TextColor3", "Text")

			local preview = Util.New("Frame", {
				Name = "Preview",
				BackgroundColor3 = color,
				Size = UDim2.fromOffset(100, 30),
				BorderSizePixel = 0,
				Parent = bottom,
			})
			Util.Corner(7, preview)
			Util.Stroke(Color3.new(1, 1, 1), 1, 0.85, preview)

			-- Preset swatches ----------------------------------------------
			local presetRow = Util.New("Frame", {
				Name = "Presets",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				Parent = popup,
			})
			Util.List({
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				Parent = presetRow,
			})

			-- Rendering ----------------------------------------------------
			local function apply(nextColor: Color3, fireCallback: boolean?)
				color = nextColor
				h, s, v = Color3.toHSV(color)
				sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				cursor.Position = UDim2.new(s, 0, 1 - v, 0)
				cursor.BackgroundColor3 = color
				hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
				preview.BackgroundColor3 = color
				hexInput.Text = "#" .. Util.ToHex(color)
				swatch.BackgroundColor3 = color
				hexLabel.Text = "#" .. Util.ToHex(color)
				object.Value = color
				if fireCallback ~= false then
					Util.SafeCall(config.Callback, color)
				end
			end

			local function pickSV(x: number, y: number)
				local sx = math.clamp((x - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				local sy = math.clamp((y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				apply(Color3.fromHSV(h, sx, 1 - sy))
			end

			apply(color, false)

			local svDragging, hueDragging = false, false

			sv.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					svDragging = true
					pickSV(input.Position.X, input.Position.Y)
				end
			end)

			hueStrip.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					hueDragging = true
					local nx = math.clamp((input.Position.X - hueStrip.AbsolutePosition.X) / math.max(hueStrip.AbsoluteSize.X, 1), 0, 1)
					apply(Color3.fromHSV(nx, math.max(s, 0.01), math.max(v, 0.01)))
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if not popup or not popup.Parent then
					return
				end
				if svDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					pickSV(input.Position.X, input.Position.Y)
				elseif hueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local nx = math.clamp((input.Position.X - hueStrip.AbsolutePosition.X) / math.max(hueStrip.AbsoluteSize.X, 1), 0, 1)
					h = nx
					apply(Color3.fromHSV(h, math.max(s, 0.01), math.max(v, 0.01)))
				end
			end)

			UserInputService.InputEnded:Connect(function()
				svDragging, hueDragging = false, false
			end)

			hexInput.FocusLost:Connect(function()
				local text = string.gsub(hexInput.Text, "#", "")
				if #text == 6 and string.match(text, "^%x+$") then
					apply(Color3.fromHex(text))
				else
					hexInput.Text = "#" .. Util.ToHex(color)
				end
			end)

			for _, preset in ipairs(PRESETS) do
				local dot = Util.New("Frame", {
					Name = "Preset",
					BackgroundColor3 = Color3.fromHex(preset),
					Size = UDim2.fromOffset(20, 20),
					BorderSizePixel = 0,
					Parent = presetRow,
				})
				Util.Corner(6, dot)
				Util.Stroke(Color3.new(1, 1, 1), 1, 0.88, dot)
				Util.OnClick(dot, function()
					apply(Color3.fromHex(preset))
				end)
				dot.MouseEnter:Connect(function()
					Util.Tween(dot, { Size = UDim2.fromOffset(22, 22) }, "Fast")
				end)
				dot.MouseLeave:Connect(function()
					Util.Tween(dot, { Size = UDim2.fromOffset(20, 20) }, "Fast")
				end)
			end

			-- Position -----------------------------------------------------
			local overlayPos = overlay.AbsolutePosition
			local triggerTop = trigger.AbsolutePosition.Y - overlayPos.Y
			local triggerBottom = triggerTop + trigger.AbsoluteSize.Y
			local estimated = 214
			local x = math.clamp(
				trigger.AbsolutePosition.X - overlayPos.X + trigger.AbsoluteSize.X - width,
				8,
				math.max(8, overlay.AbsoluteSize.X - width - 8)
			)
			popup.Position = UDim2.fromOffset(
				x,
				(triggerBottom + estimated > overlay.AbsoluteSize.Y - 8) and math.max(8, triggerTop - estimated - 6) or (triggerBottom + 6)
			)

			local scale = Util.Scale(popup)
			scale.Scale = 0.96
			Util.Tween(scale, { Scale = 1 }, "Fast")

			Util.OnClick(catcher, close)
		end

		close = function()
			if not isOpen then
				return
			end
			isOpen = false
			if catcher then
				catcher:Destroy()
				catcher = nil
			end
			if popup then
				local dying = popup
				popup = nil
				Util.Fade(dying, 1, "Fast")
				task.delay(0.16, function()
					if dying then
						dying:Destroy()
					end
				end)
			end
		end

		Util.OnClick(trigger, function()
			if isOpen then
				close()
			else
				isOpen = true
				build()
			end
		end)
		Util.OnClick(row.Frame, function()
			if not isOpen then
				isOpen = true
				build()
			end
		end)

		renderTrigger()

		function object.Get(self): Color3
			return color
		end

		function object.Set(self, nextColor: Color3, silent: boolean?)
			color = nextColor
			h, s, v = Color3.toHSV(color)
			renderTrigger()
			if not silent then
				Util.SafeCall(config.Callback, color)
			end
		end

		function object.Destroy(self)
			close()
			row.Frame:Destroy()
		end

		return object
	end

	return ColorPicker
end

Modules["Section"] = function()
	--[[
		Aurora UI  •  Section.luau
		------------------------------------------------------------------
		A titled card that groups controls. Every Add* method forwards to
		the matching component module and registers the row with the
		window's search index so Ctrl+F / the title-bar search can find it.
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")

	local Button = __req("Button")
	local Toggle = __req("Toggle")
	local Slider = __req("Slider")
	local Dropdown = __req("Dropdown")
	local TextBox = __req("TextBox")
	local Keybind = __req("Keybind")
	local ColorPicker = __req("ColorPicker")

	local Section = {}

	function Section.New(window, parent: Instance, config: { [string]: any })
		config = config or {}

		local section = {}
		local collapsed = config.Collapsed == true
		local chevron

		-- Card -------------------------------------------------------------
		-- Five card treatments, chosen by the active style:
		--   glass    transparent tinted panel (Midnight, Frost, Solar)
		--   elevated solid panel + drop shadow (Daylight, Material You)
		--   outline  no fill, bright hairline (Neon Grid, Executive)
		--   flat     solid panel, no border (Terminal)
		--   brutal   paper fill, heavy border, hard offset shadow (Brutalist, Arcade)
		local cardKind = config.Card or Util.M("Card", "glass")
		local cardColor, cardTransparency = Util.Theme.Surface, 0
		local strokeColor, strokeThickness, strokeAlpha = Util.Theme.StrokeSoft, 1, 0

		if cardKind == "glass" then
			cardTransparency = math.clamp((Util.Theme.Glass or 0) + 0.06, 0, 0.9)
		elseif cardKind == "elevated" then
			cardColor = Util.Theme.Elevated
		elseif cardKind == "outline" then
			cardTransparency = 1
			strokeColor, strokeThickness, strokeAlpha = Util.Theme.StrokeBright, 1.2, 0.25
		elseif cardKind == "brutal" then
			cardColor = Util.Theme.PanelSolid
			strokeColor, strokeThickness, strokeAlpha = Util.Theme.Text, 2, 0
		end

		local card = Util.New("Frame", {
			Name = "Section_" .. (config.Name or "Group"),
			BackgroundColor3 = cardColor,
			BackgroundTransparency = cardTransparency,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(14, card)
		Util.Stroke(strokeColor, strokeThickness, strokeAlpha, card)
		Util.Padding({ X = 10, Y = 10 }, card)
		Util.List({ Padding = UDim.new(0, 4), Parent = card })
		Util.Themable(card, "BackgroundColor3", cardKind == "elevated" and "Elevated" or "Surface")

		if cardKind == "elevated" then
			-- clean hairline instead of a drop shadow: the card is auto-sized,
			-- and a sibling shadow would have nothing to measure at build time
			Util.Stroke(Util.Theme.Stroke, 1, 0.45, card)
		elseif cardKind == "brutal" then
			local backerStroke = Util.Stroke(Util.Theme.Text, 2, 0, card)
			backerStroke:SetAttribute("AuroraBrutal", true)
		end

		-- Header -----------------------------------------------------------
		-- Positioned by hand rather than with a UIListLayout: the optional
		-- description occupies a second line, which a horizontal list cannot
		-- express (and a full-size spacer would push the chevron off the card).
		local sectionTitle, sectionHeader
		if config.Name or config.Icon then
			local hasDescription = config.Description ~= nil
			local rowHeight = hasDescription and 18 or 26
			local iconSize = 14
			local textLeft = config.Icon and (iconSize + 8) or 0

			local header = Util.New("Frame", {
				Name = "Header",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, hasDescription and 38 or 26),
				Parent = card,
			})

			if config.Icon then
				local icon = Icons.Get(config.Icon, header, {
					Size = iconSize,
					Color = Util.Theme.Accent,
					Mask = Util.Theme.Surface,
				})
				icon.AnchorPoint = Vector2.new(0, 0.5)
				icon.Position = UDim2.new(0, 0, 0, hasDescription and 8 or 13)
			end

			local titleText = config.Name or ""
			if Util.M("HeaderCase", "normal") == "upper" then
				titleText = string.upper(titleText)
			end

			local title = Util.Text({
				Name = "Title",
				Text = titleText,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = Util.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				AnchorPoint = Vector2.new(0, hasDescription and 0 or 0.5),
				Position = UDim2.new(0, textLeft, 0, hasDescription and 0 or 13),
				Size = UDim2.fromOffset(0, rowHeight),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = header,
			})
			Util.Themable(title, "TextColor3", "Text")
			sectionTitle = title
			sectionHeader = header

			local titleWidth = Util.TextWidth(titleText, 13)

			if config.Badge then
				local badge = Util.New("Frame", {
					Name = "Badge",
					BackgroundColor3 = Util.Theme.AccentSoft,
					AnchorPoint = Vector2.new(0, hasDescription and 0 or 0.5),
					Position = UDim2.new(0, textLeft + titleWidth + 8, 0, hasDescription and 1 or 13),
					Size = UDim2.fromOffset(0, 17),
					AutomaticSize = Enum.AutomaticSize.X,
					BorderSizePixel = 0,
					Parent = header,
				})
				Util.Corner(5, badge)
				Util.Padding({ X = 6 }, badge)
				Util.Themable(badge, "BackgroundColor3", "AccentSoft")
				local badgeLabel = Util.Text({
					Text = tostring(config.Badge),
					Font = Enum.Font.GothamBold,
					TextSize = 9,
					TextColor3 = Util.Theme.Accent,
					TextXAlignment = Enum.TextXAlignment.Center,
					Size = UDim2.fromOffset(0, 17),
					AutomaticSize = Enum.AutomaticSize.X,
					Parent = badge,
				})
				Util.Themable(badgeLabel, "TextColor3", "Accent")
			end

			if config.Collapsible ~= false then
				chevron = Icons.Get("chevronDown", header, {
					Size = 12,
					Color = Util.Theme.TextDim,
					Mask = Util.Theme.Surface,
				})
				chevron.Rotation = collapsed and -90 or 0
				chevron.AnchorPoint = Vector2.new(1, 0.5)
				chevron.Position = UDim2.new(1, 0, 0, hasDescription and 9 or 13)

				local hitbox = Util.New("Frame", {
					Name = "CollapseHitbox",
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(22, 22),
					Parent = header,
				})
				hitbox.AnchorPoint = Vector2.new(1, 0.5)
				hitbox.Position = UDim2.new(1, 0, 0, hasDescription and 9 or 13)

				Util.OnClick(hitbox, function()
					section:SetCollapsed(not collapsed)
				end)
			end

			if hasDescription then
				local description = Util.Text({
					Name = "Description",
					Text = config.Description,
					Font = Enum.Font.Gotham,
					TextSize = 11,
					TextColor3 = Util.Theme.TextMuted,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0, textLeft, 0, 20),
					Size = UDim2.new(1, -(textLeft + 26), 0, 15),
					Parent = header,
				})
				Util.Themable(description, "TextColor3", "TextMuted")
			end
		end

		-- Section variants --------------------------------------------------
		-- panels    : the default card, tinted per style
		-- cards     : no shell at all, every control is its own card
		-- list      : flat panel, hairline rule under an uppercase header
		-- console   : mono, accent rule, reads like a terminal pane
		-- accordion : floating pill header over an open body
		local sectionKind = config.Section or Util.M("Sections", "panels")
		local cardStroke = card:FindFirstChildOfClass("UIStroke")

		if sectionKind == "cards" then
			card.BackgroundTransparency = 1
			if cardStroke then
				cardStroke.Enabled = false
			end
			Util.Padding({ X = 0, Y = 2 }, card)
			if sectionTitle then
				sectionTitle.TextSize = 12
			end
		elseif sectionKind == "list" then
			card.BackgroundTransparency = 0.45
			Util.Corner(6, card)
			Util.Padding({ X = 8, Y = 8 }, card)
			if cardStroke then
				cardStroke.Transparency = 0.55
			end
			if sectionTitle then
				sectionTitle.Text = string.upper(sectionTitle.Text)
				sectionTitle.TextSize = 11
			end
			if sectionHeader then
				Util.New("Frame", {
					Name = "Rule",
					BackgroundColor3 = Util.Theme.StrokeSoft,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, 0),
					Size = UDim2.new(1, 0, 0, 1),
					BorderSizePixel = 0,
					Parent = sectionHeader,
				})
			end
		elseif sectionKind == "console" then
			card.BackgroundTransparency = 0.2
			Util.Corner(3, card)
			if cardStroke then
				cardStroke.Color = Util.Theme.Accent
				cardStroke.Transparency = 0.55
			end
			if sectionTitle then
				sectionTitle.Font = Enum.Font.Code
				sectionTitle.Text = "> " .. string.upper(sectionTitle.Text)
				sectionTitle.TextSize = 12
				sectionTitle.TextColor3 = Util.Theme.Accent
			end
		elseif sectionKind == "accordion" then
			card.BackgroundTransparency = 1
			if cardStroke then
				cardStroke.Enabled = false
			end
			if sectionHeader then
				sectionHeader.BackgroundColor3 = Util.Theme.Surface
				sectionHeader.BackgroundTransparency = 0.05
				Util.Corner(999, sectionHeader)
				Util.Padding({ X = 12 }, sectionHeader)
				Util.Themable(sectionHeader, "BackgroundColor3", "Surface")
			end
			if sectionTitle then
				sectionTitle.Text = string.upper(sectionTitle.Text)
				sectionTitle.TextSize = 11
				sectionTitle.TextColor3 = Util.Theme.TextMuted
			end
		end

		-- Body -------------------------------------------------------------
		local body = Util.New("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = not collapsed,
			Parent = card,
		})
		Util.List({ Padding = UDim.new(0, 2), Parent = body })

		section.Instance = card
		section.Body = body
		section.Collapsed = collapsed

		--- Collapse / expand the card body.
		function section:SetCollapsed(value: boolean)
			collapsed = value == true
			section.Collapsed = collapsed
			body.Visible = not collapsed
			if chevron then
				Util.Tween(chevron, { Rotation = collapsed and -90 or 0 }, "Fast")
			end
		end

		function section:ToggleCollapsed()
			section:SetCollapsed(not collapsed)
		end
		section.Name = config.Name
		section.Window = window

		local function register(component, controlConfig)
			if window then
				window:_registerSearch({
					Name = controlConfig.Name or "Control",
					Section = config.Name,
					Kind = component.Kind or "Control",
					Frame = component.Instance,
					Object = component,
				})
			end
			return component
		end

		function section.AddToggle(self, controlConfig)
			return register(Toggle.New(window, body, controlConfig), controlConfig)
		end

		function section.AddSlider(self, controlConfig)
			return register(Slider.New(window, body, controlConfig), controlConfig)
		end

		function section.AddDropdown(self, controlConfig)
			return register(Dropdown.New(window, body, controlConfig), controlConfig)
		end

		function section.AddTextBox(self, controlConfig)
			return register(TextBox.New(window, body, controlConfig), controlConfig)
		end

		function section.AddKeybind(self, controlConfig)
			return register(Keybind.New(window, body, controlConfig), controlConfig)
		end

		function section.AddColorPicker(self, controlConfig)
			return register(ColorPicker.New(window, body, controlConfig), controlConfig)
		end

		function section.AddButton(self, controlConfig)
			controlConfig.FullWidth = controlConfig.FullWidth == nil or controlConfig.FullWidth
			local component = Button.New(window, body, controlConfig)
			if controlConfig.Name then
				window:_registerSearch({
					Name = controlConfig.Name,
					Section = config.Name,
					Kind = "Button",
					Frame = component.Instance,
					Object = component,
				})
			end
			return component
		end

		--- Plain paragraph inside the card.
		function section.AddLabel(self, text: string, opts: { [string]: any }?)
			opts = opts or {}
			local label = Util.Text({
				Name = "Paragraph",
				Text = text,
				Font = opts.Bold and Enum.Font.GothamBold or Enum.Font.Gotham,
				TextSize = opts.TextSize or 12,
				TextColor3 = Util.Theme[opts.Token or "TextMuted"],
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Size = UDim2.new(1, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Position = UDim2.fromOffset(8, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = body,
			})
			Util.Themable(label, "TextColor3", opts.Token or "TextMuted")
			return label
		end

		--- Hairline divider.
		function section.AddDivider(self, opts: { [string]: any }?)
			opts = opts or {}
			local divider = Util.New("Frame", {
				Name = "Divider",
				BackgroundColor3 = Util.Theme.StrokeSoft,
				Size = UDim2.new(1, 0, 0, 1),
				BorderSizePixel = 0,
				Parent = body,
			})
			Util.Themable(divider, "BackgroundColor3", "StrokeSoft")
			if opts.Spacing then
				Util.New("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, opts.Spacing),
					Parent = body,
				})
			end
			return divider
		end

		--- Escape hatch: hand the raw body frame to your own code.
		function section.AddRow(self, configFactory)
			return configFactory(body)
		end

		function section.SetVisible(self, value: boolean)
			card.Visible = value
		end

		return section
	end

	return Section
end

Modules["Notification"] = function()
	--[[
		Aurora UI  •  Notification.luau
		------------------------------------------------------------------
		Stacked toast cards with type theming, an icon, auto-dismiss timer
		and a shrinking progress bar. Toasts slide in with a scale/fade so
		the list layout can keep reflowing without fighting tweens.
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")

	local Notification = {}

	local TYPE_MAP = {
		info = { Token = "Info", Icon = "info" },
		success = { Token = "Success", Icon = "check" },
		warning = { Token = "Warning", Icon = "warning" },
		error = { Token = "Danger", Icon = "close" },
		default = { Token = "Accent", Icon = "sparkle" },
	}

	local function resolveType(config): (string, string)
		local entry = TYPE_MAP[config.Type or "default"] or TYPE_MAP.default
		return entry.Token, config.Icon or entry.Icon
	end

	function Notification.New(window, config: { [string]: any })
		config = config or {}
		local token, iconName = resolveType(config)
		local accent: Color3 = Util.Theme[token] or Util.Theme.Accent
		local duration = config.Duration or 4.5

		local holder = window:_notificationHolder()

		local card = Util.New("Frame", {
			Name = "Toast",
			BackgroundColor3 = Util.Theme.Elevated,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = holder,
		})
		Util.Corner(12, card)
		local cardStroke = Util.Stroke(Util.Theme.StrokeBright, 1, 0.45, card)
		Util.Padding({ X = 14, Y = 12 }, card)
		Util.Themable(card, "BackgroundColor3", "Elevated")

		local scale = Util.Scale(card)
		scale.Scale = 0.94

		local content = Util.New("Frame", {
			Name = "Content",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = card,
		})
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Parent = content,
		})

		-- Accent rail ------------------------------------------------------
		local rail = Util.New("Frame", {
			Name = "Rail",
			BackgroundColor3 = accent,
			Size = UDim2.fromOffset(3, 30),
			BorderSizePixel = 0,
			Parent = card,
		})
		Util.Corner(999, rail)
		rail.AnchorPoint = Vector2.new(0, 0)
		rail.Position = UDim2.new(0, 0, 0, 12)
		rail.Size = UDim2.new(0, 3, 1, -24)

		-- Icon badge -------------------------------------------------------
		local badge = Util.New("Frame", {
			Name = "Badge",
			BackgroundColor3 = accent,
			BackgroundTransparency = 0.84,
			Size = UDim2.fromOffset(26, 26),
			BorderSizePixel = 0,
			Parent = content,
		})
		Util.Corner(8, badge)

		local icon = Icons.Get(iconName, badge, {
			Size = 13,
			Color = accent,
			Mask = Util.Theme.Elevated,
		})
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)

		-- Text -------------------------------------------------------------
		local textHolder = Util.New("Frame", {
			Name = "Text",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -74, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = content,
		})
		Util.List({ Padding = UDim.new(0, 2), Parent = textHolder })

		if config.Title then
			local title = Util.Text({
				Name = "Title",
				Text = config.Title,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = Util.Theme.Text,
				Size = UDim2.new(1, 0, 0, 17),
				Parent = textHolder,
			})
			Util.Themable(title, "TextColor3", "Text")
		end

		if config.Body then
			local body = Util.Text({
				Name = "Body",
				Text = config.Body,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Util.Theme.TextMuted,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = textHolder,
			})
			Util.Themable(body, "TextColor3", "TextMuted")
		end

		-- Close ------------------------------------------------------------
		local closeButton = Util.New("Frame", {
			Name = "Close",
			BackgroundColor3 = Util.Theme.SurfaceHover,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(20, 20),
			BorderSizePixel = 0,
			Parent = card,
		})
		Util.Corner(6, closeButton)
		closeButton.AnchorPoint = Vector2.new(1, 0)
		closeButton.Position = UDim2.new(1, 0, 0, 0)

		local closeIcon = Icons.Get("close", closeButton, {
			Size = 9,
			Color = Util.Theme.TextDim,
			Mask = Util.Theme.Elevated,
		})
		closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
		closeIcon.Position = UDim2.fromScale(0.5, 0.5)

		closeButton.MouseEnter:Connect(function()
			Util.Tween(closeButton, { BackgroundTransparency = 0 }, "Fast")
		end)
		closeButton.MouseLeave:Connect(function()
			Util.Tween(closeButton, { BackgroundTransparency = 1 }, "Fast")
		end)

		-- Progress ---------------------------------------------------------
		local progressTrack = Util.New("Frame", {
			Name = "ProgressTrack",
			BackgroundColor3 = Util.Theme.StrokeSoft,
			Size = UDim2.new(1, -28, 0, 2),
			BorderSizePixel = 0,
			Parent = card,
		})
		Util.Corner(999, progressTrack)
		progressTrack.AnchorPoint = Vector2.new(0, 1)
		progressTrack.Position = UDim2.new(0, 14, 1, -4)
		Util.Themable(progressTrack, "BackgroundColor3", "StrokeSoft")

		local progress = Util.New("Frame", {
			Name = "Progress",
			BackgroundColor3 = accent,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			Parent = progressTrack,
		})
		Util.Corner(999, progress)

		-- Lifecycle --------------------------------------------------------
		local object = { Instance = card, Kind = "Notification" }
		local dismissed = false

		local function dismiss()
			if dismissed or not card.Parent then
				return
			end
			dismissed = true
			Util.Tween(scale, { Scale = 0.9 }, "Fast")
			Util.Tween(card, { Size = UDim2.new(1, 0, 0, 0) }, "Fast")
			task.delay(0.2, function()
				if card then
					card:Destroy()
				end
			end)
			Util.SafeCall(config.OnDismiss)
		end

		Util.OnClick(closeButton, dismiss)
		Util.OnClick(card, function()
			if config.ClickToDismiss ~= false then
				dismiss()
			end
		end)

		-- Entrance ---------------------------------------------------------
		task.defer(function()
			Util.Tween(scale, { Scale = 1 }, "Spring")
		end)

		if duration > 0 then
			Util.Tween(progress, { Size = UDim2.fromScale(0, 1) }, duration)
			task.delay(duration, dismiss)
		end

		function object.Dismiss(self)
			dismiss()
		end

		return object
	end

	return Notification
end

Modules["Tooltip"] = function()
	--[[
		Aurora UI  •  Tooltip.luau
		------------------------------------------------------------------
		One shared tooltip layer. Anything can opt in by tagging itself:

			someRow:SetAttribute("Tooltip", "Explained here")

		The layer samples the GUI objects under the cursor a few times per
		second (cheap) and walks up the hierarchy looking for the tag.
	--]]

	local Util = __req("Util")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")

	local Tooltip = {}

	local player = Players.LocalPlayer

	function Tooltip.Init(window)
		if Tooltip._initialized then
			return
		end

		-- Phones have no cursor, so the whole layer is pointless there.
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return
		end

		Tooltip._initialized = true

		local gui = Util.New("ScreenGui", {
			Name = "AuroraTooltip",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 300,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = player:WaitForChild("PlayerGui"),
		})

		local bubble = Util.New("Frame", {
			Name = "Bubble",
			BackgroundColor3 = Util.Theme.Elevated,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 5,
			Parent = gui,
		})
		Util.Corner(7, bubble)
		local stroke = Util.Stroke(Util.Theme.StrokeBright, 1, 1, bubble)
		Util.Padding({ X = 9, Y = 5 }, bubble)
		Util.Themable(bubble, "BackgroundColor3", "Elevated")
		Util.Themable(stroke, "Color", "StrokeBright")

		local label = Util.Text({
			Name = "Text",
			Text = "",
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = Util.Theme.Text,
			TextTransparency = 1,
			Size = UDim2.fromOffset(0, 14),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = bubble,
		})
		Util.Themable(label, "TextColor3", "Text")

		local currentTarget, currentText, shown = nil, nil, false
		local accumulator = 0

		local function hide()
			if not shown then
				return
			end
			shown = false
			Util.Tween(bubble, { BackgroundTransparency = 1 }, "Fast")
			Util.Tween(stroke, { Transparency = 1 }, "Fast")
			Util.Tween(label, { TextTransparency = 1 }, "Fast")
			task.delay(0.16, function()
				if not shown then
					bubble.Visible = false
				end
			end)
		end

		local function show(text: string)
			label.Text = text
			bubble.Visible = true
			shown = true
			Util.Tween(bubble, { BackgroundTransparency = 0.02 }, "Fast")
			Util.Tween(stroke, { Transparency = 0.45 }, "Fast")
			Util.Tween(label, { TextTransparency = 0 }, "Fast")
		end

		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		local canHitTest = playerGui ~= nil and type(playerGui.GetGuiObjectsAtPosition) == "function"

		local function findTarget(x: number, y: number)
			if not canHitTest or not playerGui then
				return nil, nil
			end
			local ok, objects = pcall(function()
				return playerGui:GetGuiObjectsAtPosition(x, y)
			end)
			if not ok or type(objects) ~= "table" then
				canHitTest = false
				return nil, nil
			end
			for _, object in ipairs(objects) do
				local cursor = object
				while cursor and cursor ~= playerGui do
					local text = cursor:GetAttribute("Tooltip")
					if text then
						return cursor, text
					end
					cursor = cursor.Parent
				end
			end
			return nil, nil
		end

		RunService.RenderStepped:Connect(function(dt)
			accumulator += dt
			if accumulator < 0.06 then
				return
			end
			accumulator = 0

			if not gui.Parent then
				return
			end

			local position = UserInputService:GetMouseLocation()
			local target, text = findTarget(position.X, position.Y)

			if target and text then
				if target ~= currentTarget or text ~= currentText then
					currentTarget, currentText = target, text
					show(text)
				end
				local viewport = workspace.CurrentCamera.ViewportSize
				local width = bubble.AbsoluteSize.X
				local x = math.clamp(position.X + 14, 8, viewport.X - width - 8)
				local y = position.Y + 22
				if y + bubble.AbsoluteSize.Y > viewport.Y - 8 then
					y = position.Y - bubble.AbsoluteSize.Y - 10
				end
				bubble.Position = UDim2.fromOffset(x, y)
			elseif shown then
				currentTarget, currentText = nil, nil
				hide()
			end
		end)

		Tooltip.Bubble = bubble
	end

	return Tooltip
end

Modules["StatCard"] = function()
	--[[
		Aurora UI  •  StatCard.luau
		------------------------------------------------------------------
		Dashboard metric card: label, animated counter, delta pill and a
		live sparkline built from bars. Meant to sit inside a UIGridLayout
		grid (see Tab:AddGrid).
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")

	local StatCard = {}

	local BAR_COUNT = 16

	------------------------------------------------------------------
	-- formatting shared by every variant
	------------------------------------------------------------------

	local function makeFormatter(config)
		return function(value: number): string
			if config.Format then
				local ok, text = pcall(config.Format, value)
				if ok then
					return tostring(text)
				end
			end
			return Util.FormatNumber(value)
		end
	end

	local function deltaText(config): string?
		if config.Delta == nil then
			return nil
		end
		local delta = config.Delta
		return string.format("%s%.1f%%", delta >= 0 and "+" or "", delta)
	end

	local function deltaColor(config): Color3
		if (config.Delta or 0) >= 0 then
			return Util.Theme.Success
		end
		return Util.Theme.Danger
	end

	------------------------------------------------------------------
	-- variant: rows -- one line per metric, like a table row
	------------------------------------------------------------------

	local function buildRow(parent, config, token)
		local format = makeFormatter(config)

		local row = Util.New("Frame", {
			Name = "StatRow_" .. (config.Title or "Metric"),
			BackgroundColor3 = Util.Theme.Surface,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(8, row)
		Util.Padding({ X = 10 }, row)

		local line = Util.New("Frame", {
			Name = "Line",
			BackgroundColor3 = Util.Theme.StrokeSoft,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 1),
			BorderSizePixel = 0,
			Parent = row,
		})
		Util.Themable(line, "BackgroundColor3", "StrokeSoft")

		if config.Icon then
			local icon = Icons.Get(config.Icon, row, {
				Size = 13,
				Color = Util.Theme[token],
				Mask = Util.Theme.Surface,
			})
			Util.Themable(icon, "ImageColor3", token)
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 0, 0.5, 0)
		end

		local title = Util.Text({
			Name = "Title",
			Text = config.Title or "Metric",
			Font = Util.M("Mono", false) and Enum.Font.Code or Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = Util.Theme.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(config.Icon and 20 or 0, 0),
			Size = UDim2.new(0.5, -(config.Icon and 20 or 0), 1, 0),
			Parent = row,
		})
		Util.Themable(title, "TextColor3", "TextMuted")

		local value = Util.Text({
			Name = "Value",
			Text = format(config.Value or 0),
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, config.Delta ~= nil and -46 or 0, 0, 0),
			Size = UDim2.fromOffset(80, 18),
			Parent = row,
		})
		value.AnchorPoint = Vector2.new(1, 0.5)
		value.Position = UDim2.new(1, config.Delta ~= nil and -46 or 0, 0.5, 0)
		Util.Themable(value, "TextColor3", "Text")

		if config.Delta ~= nil then
			local delta = Util.Text({
				Name = "Delta",
				Text = deltaText(config),
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				TextColor3 = deltaColor(config),
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(42, 16),
				Parent = row,
			})
			Util.Themable(delta, "TextColor3", (config.Delta or 0) >= 0 and "Success" or "Danger")
		end

		return {
			Instance = row,
			Kind = "StatCard",
			SetValue = function(self, nextValue: number)
				value.Text = format(nextValue)
			end,
			SetData = function() end,
			SetDelta = function() end,
			Destroy = function(self)
				row:Destroy()
			end,
		}
	end

	------------------------------------------------------------------
	-- variant: chips -- a compact pill, for dense dashboards
	------------------------------------------------------------------

	local function buildChip(parent, config, token)
		local format = makeFormatter(config)

		local chip = Util.New("Frame", {
			Name = "StatChip_" .. (config.Title or "Metric"),
			BackgroundColor3 = Util.Theme.Surface,
			BackgroundTransparency = 0.1,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(999, chip)
		Util.Stroke(Util.Theme.StrokeSoft, 1, 0.2, chip)
		Util.Padding({ X = 12 }, chip)
		Util.Themable(chip, "BackgroundColor3", "Surface")

		local dot = Util.New("Frame", {
			Name = "Dot",
			BackgroundColor3 = Util.Theme[token],
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(8, 8),
			BorderSizePixel = 0,
			Parent = chip,
		})
		Util.Corner(999, dot)
		Util.Themable(dot, "BackgroundColor3", token)

		local value = Util.Text({
			Name = "Value",
			Text = format(config.Value or 0),
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextColor3 = Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(0.55, -16, 1, 0),
			Parent = chip,
		})
		Util.Themable(value, "TextColor3", "Text")

		local title = Util.Text({
			Name = "Title",
			Text = string.upper(config.Title or "Metric"),
			Font = Enum.Font.GothamMedium,
			TextSize = 9,
			TextColor3 = Util.Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0.45, 0, 1, 0),
			Parent = chip,
		})
		Util.Themable(title, "TextColor3", "TextDim")

		return {
			Instance = chip,
			Kind = "StatCard",
			SetValue = function(self, nextValue: number)
				value.Text = format(nextValue)
			end,
			SetData = function() end,
			SetDelta = function() end,
			Destroy = function(self)
				chip:Destroy()
			end,
		}
	end

	------------------------------------------------------------------
	-- variant: headline -- one big number, thin fill bar underneath
	------------------------------------------------------------------

	local function buildHeadline(parent, config, token)
		local format = makeFormatter(config)

		local card = Util.New("Frame", {
			Name = "StatHeadline_" .. (config.Title or "Metric"),
			BackgroundColor3 = Util.Theme.Surface,
			BackgroundTransparency = 0.06,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(16, card)
		Util.Padding({ X = 14, Y = 10 }, card)
		Util.Themable(card, "BackgroundColor3", "Surface")

		local label = Util.Text({
			Name = "Label",
			Text = string.upper(config.Title or "Metric"),
			Font = Enum.Font.GothamMedium,
			TextSize = 9,
			TextColor3 = Util.Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 12),
			Parent = card,
		})
		Util.Themable(label, "TextColor3", "TextDim")

		local value = Util.Text({
			Name = "Value",
			Text = format(config.Value or 0),
			Font = Enum.Font.GothamBlack,
			TextSize = 27,
			TextColor3 = Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(0, 14),
			Size = UDim2.new(1, -46, 0, 32),
			Parent = card,
		})
		Util.Themable(value, "TextColor3", "Text")

		if config.Delta ~= nil then
			local delta = Util.Text({
				Name = "Delta",
				Text = deltaText(config),
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				TextColor3 = deltaColor(config),
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 22),
				Size = UDim2.fromOffset(44, 16),
				Parent = card,
			})
			Util.Themable(delta, "TextColor3", (config.Delta or 0) >= 0 and "Success" or "Danger")
		end

		-- fill bar: the only chart this variant has
		local track = Util.New("Frame", {
			Name = "Track",
			BackgroundColor3 = Util.Theme.StrokeSoft,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 3),
			BorderSizePixel = 0,
			Parent = card,
		})
		Util.Corner(999, track)
		Util.Themable(track, "BackgroundColor3", "StrokeSoft")

		local peak = config.Max or ((config.Value or 0) * 1.32)
		local fill = Util.New("Frame", {
			Name = "Fill",
			BackgroundColor3 = Util.Theme[token],
			Size = UDim2.fromScale(math.clamp((config.Value or 0) / math.max(peak, 0.001), 0.05, 1), 1),
			BorderSizePixel = 0,
			Parent = track,
		})
		Util.Corner(999, fill)
		Util.Gradient(ColorSequence.new(Util.Theme[token], Util.Theme.Accent2), 0, fill)
		Util.Themable(fill, "BackgroundColor3", token)

		return {
			Instance = card,
			Kind = "StatCard",
			SetValue = function(self, nextValue: number)
				value.Text = format(nextValue)
				fill.Size = UDim2.fromScale(math.clamp(nextValue / math.max(peak, 0.001), 0.05, 1), 1)
			end,
			SetData = function() end,
			SetDelta = function() end,
			Destroy = function(self)
				card:Destroy()
			end,
		}
	end

	------------------------------------------------------------------
	-- variant: dials -- a ring of segments, no chart, no numbers row
	------------------------------------------------------------------

	local SEGMENTS = 14
	local DIAL_SIZE = 64

	local function buildDial(parent, config, token)
		local format = makeFormatter(config)

		local card = Util.New("Frame", {
			Name = "StatDial_" .. (config.Title or "Metric"),
			BackgroundColor3 = Util.Theme.Surface,
			BackgroundTransparency = 0.08,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(16, card)
		Util.Themable(card, "BackgroundColor3", "Surface")

		local dial = Util.New("Frame", {
			Name = "Dial",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(DIAL_SIZE, DIAL_SIZE),
			Parent = card,
		})

		local samples = config.Data or {}
		local peak = config.Max or 0
		if peak <= 0 then
			for _, sample in ipairs(samples) do
				peak = math.max(peak, sample)
			end
			peak = math.max(peak, (config.Value or 0) * 1.25, 1)
		end
		local fraction = math.clamp((config.Value or 0) / peak, 0, 1)
		local lit = math.max(1, math.round(fraction * SEGMENTS))

		local radius = DIAL_SIZE / 2 - 3
		for index = 1, SEGMENTS do
			local angle = math.rad(-90 + (index - 1) * (360 / SEGMENTS))
			local dot = Util.New("Frame", {
				Name = "Seg" .. index,
				BackgroundColor3 = index <= lit and Util.Theme[token] or Util.Theme.Stroke,
				BackgroundTransparency = index <= lit and 0 or 0.65,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(
					0.5,
					math.cos(angle) * radius,
					0.5,
					math.sin(angle) * radius
				),
				Size = UDim2.fromOffset(4, 4),
				BorderSizePixel = 0,
				Parent = dial,
			})
			Util.Corner(999, dot)
			Util.Themable(dot, "BackgroundColor3", index <= lit and token or "Stroke")
		end

		local value = Util.Text({
			Name = "Value",
			Text = format(config.Value or 0),
			Font = Enum.Font.GothamBold,
			TextSize = 10,
			TextColor3 = Util.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.fromScale(0.78, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Parent = dial,
		})
		Util.Themable(value, "TextColor3", "Text")

		local title = Util.Text({
			Name = "Title",
			Text = config.Title or "Metric",
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Util.Theme.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(DIAL_SIZE + 22, 14),
			Size = UDim2.new(1, -(DIAL_SIZE + 34), 0, 16),
			Parent = card,
		})
		Util.Themable(title, "TextColor3", "TextMuted")

		local sub = Util.Text({
			Name = "Sub",
			Text = deltaText(config) or string.format("%d%% of %s", math.round(fraction * 100), format(peak)),
			Font = Util.M("Mono", false) and Enum.Font.Code or Enum.Font.Gotham,
			TextSize = 10,
			TextColor3 = deltaColor(config),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(DIAL_SIZE + 22, 32),
			Size = UDim2.new(1, -(DIAL_SIZE + 34), 0, 14),
			Parent = card,
		})
		Util.Themable(sub, "TextColor3", (config.Delta or 0) >= 0 and "Success" or "Danger")

		return {
			Instance = card,
			Kind = "StatCard",
			SetValue = function(self, nextValue: number)
				value.Text = format(nextValue)
				local now = math.max(1, math.round(math.clamp(nextValue / peak, 0, 1) * SEGMENTS))
				for index = 1, SEGMENTS do
					local seg = dial:FindFirstChild("Seg" .. index)
					if seg then
						seg.BackgroundTransparency = index <= now and 0 or 0.65
					end
				end
			end,
			SetData = function() end,
			SetDelta = function() end,
			Destroy = function(self)
				card:Destroy()
			end,
		}
	end

	function StatCard.New(window, parent: Instance, config: { [string]: any })
		config = config or {}
		local token = config.Token or "Accent"

		-- The style's blueprint picks the presentation: three cards, a table of
		-- rows, a row of pills, one hero number, or a ring of dials.
		local variant = config.Variant or Util.M("Stats", "cards")
		if variant == "rows" then
			return buildRow(parent, config, token)
		elseif variant == "chips" then
			return buildChip(parent, config, token)
		elseif variant == "headline" then
			return buildHeadline(parent, config, token)
		elseif variant == "dials" then
			return buildDial(parent, config, token)
		end

		local card = Util.New("Frame", {
			Name = "Stat_" .. (config.Title or "Metric"),
			BackgroundColor3 = Util.Theme.Surface,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = parent,
		})
		Util.Corner(14, card)
		Util.Stroke(Util.Theme.StrokeSoft, 1, 0, card)
		Util.Padding(12, card)
		Util.Themable(card, "BackgroundColor3", "Surface")

		-- Header -----------------------------------------------------------
		local header = Util.New("Frame", {
			Name = "Header",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 20),
			Parent = card,
		})
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
			Parent = header,
		})

		if config.Icon then
			local badge = Util.New("Frame", {
				Name = "Badge",
				BackgroundColor3 = Util.Theme[token],
				BackgroundTransparency = 0.85,
				Size = UDim2.fromOffset(20, 20),
				BorderSizePixel = 0,
				Parent = header,
			})
			Util.Corner(6, badge)
			Util.Themable(badge, "BackgroundColor3", function(palette)
				return palette[token]
			end)
			badge.BackgroundTransparency = 0.85

			local icon = Icons.Get(config.Icon, badge, {
				Size = 11,
				Color = Util.Theme[token],
				Mask = Util.Theme.Surface,
			})
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.5)
		end

		local title = Util.Text({
			Name = "Title",
			Text = config.Title or "Metric",
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Util.Theme.TextMuted,
			Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = header,
		})
		Util.Themable(title, "TextColor3", "TextMuted")

		-- Value ------------------------------------------------------------
		local valueRow = Util.New("Frame", {
			Name = "ValueRow",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, 0, 0, 26),
			Parent = card,
		})
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
			Parent = valueRow,
		})

		local valueLabel = Util.Text({
			Name = "Value",
			Text = "0",
			Font = Enum.Font.GothamBold,
			TextSize = 21,
			TextColor3 = Util.Theme.Text,
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = valueRow,
		})
		Util.Themable(valueLabel, "TextColor3", "Text")

		local deltaPill = Util.New("Frame", {
			Name = "Delta",
			BackgroundColor3 = Util.Theme.Success,
			BackgroundTransparency = 0.85,
			Size = UDim2.fromOffset(0, 19),
			AutomaticSize = Enum.AutomaticSize.X,
			BorderSizePixel = 0,
			Parent = valueRow,
		})
		Util.Corner(999, deltaPill)
		Util.Padding({ X = 6 }, deltaPill)
		Util.List({
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 3),
			Parent = deltaPill,
		})

		local deltaIconUp = Icons.Get("chevronUp", deltaPill, {
			Size = 9,
			Color = Util.Theme.Success,
			Mask = Util.Theme.Surface,
		})
		local deltaIconDown = Icons.Get("chevronDown", deltaPill, {
			Size = 9,
			Color = Util.Theme.Danger,
			Mask = Util.Theme.Surface,
		})
		deltaIconDown.Visible = false

		local deltaLabel = Util.Text({
			Name = "DeltaText",
			Text = "0%",
			Font = Enum.Font.GothamBold,
			TextSize = 10,
			TextColor3 = Util.Theme.Success,
			Size = UDim2.fromOffset(0, 19),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = deltaPill,
		})
		Util.Themable(deltaLabel, "TextColor3", "Success")

		-- Sparkline --------------------------------------------------------
		local chart = Util.New("Frame", {
			Name = "Chart",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 26),
			Parent = card,
		})

		local bars = {}
		for index = 1, BAR_COUNT do
			local bar = Util.New("Frame", {
				Name = "Bar" .. index,
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new((index - 1) / BAR_COUNT, 0, 1, 0),
				Size = UDim2.new((1 / BAR_COUNT) - 0.012, 0, 0.05, 0),
				BackgroundColor3 = Util.Theme[token],
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				Parent = chart,
			})
			Util.Corner(2, bar)
			Util.Themable(bar, "BackgroundColor3", function(palette)
				return palette[token]
			end)
			bars[index] = bar
		end

		-- State ------------------------------------------------------------
		local displayed = 0
		local target = config.Value or 0
		local data = config.Data or {}

		local function format(value: number): string
			if config.Format then
				local ok, text = pcall(config.Format, value)
				if ok then
					return tostring(text)
				end
			end
			return Util.FormatNumber(value)
		end

		local function renderBars(animate: boolean)
			local samples = {}
			if #data == 0 then
				for index = 1, BAR_COUNT do
					samples[index] = 0.15
				end
			else
				for index = 1, BAR_COUNT do
					local sourceIndex = math.clamp(
						math.floor(((index - 1) / (BAR_COUNT - 1)) * (#data - 1)) + 1,
						1,
						#data
					)
					samples[index] = data[sourceIndex]
				end
			end

			local maxValue = 0.0001
			for _, sample in ipairs(samples) do
				maxValue = math.max(maxValue, sample)
			end

			for index, bar in ipairs(bars) do
				local height = math.clamp(samples[index] / maxValue, 0.08, 1)
				local size = UDim2.new((1 / BAR_COUNT) - 0.012, 0, height, 0)
				if animate then
					Util.Tween(bar, { Size = size }, 0.35 + index * 0.012)
					Util.Tween(bar, { BackgroundTransparency = 0.25 + (1 - height) * 0.45 }, "Fast")
				else
					bar.Size = size
				end
			end
		end

		local function renderDelta()
			local delta = config.Delta or 0
			local positive = delta >= 0
			local palette = Util.Theme
			local color = positive and palette.Success or palette.Danger

			deltaPill.Visible = config.Delta ~= nil
			deltaLabel.Text = string.format("%s%.1f%%", positive and "+" or "", delta)
			deltaLabel.TextColor3 = color
			deltaPill.BackgroundColor3 = color
			deltaPill.BackgroundTransparency = 0.85
			deltaIconUp.Visible = positive
			deltaIconDown.Visible = not positive
			Icons.Tint(deltaIconUp, color)
			Icons.Tint(deltaIconDown, color)
		end

		local function countUp(to: number)
			local from = displayed
			Util.Animate(0.55, function(alpha)
				displayed = from + (to - from) * alpha
				valueLabel.Text = format(displayed)
			end)
		end

		local object = { Instance = card, Kind = "StatCard" }

		renderDelta()
		renderBars(false)
		countUp(target)

		function object.SetValue(self, value: number, nextData: { number }?, animate: boolean?)
			target = value
			if nextData then
				data = nextData
				renderBars(animate ~= false)
			end
			countUp(value)
		end

		function object.SetData(self, nextData: { number })
			data = nextData
			renderBars(true)
		end

		function object.SetDelta(self, delta: number)
			config.Delta = delta
			renderDelta()
		end

		function object.Destroy(self)
			card:Destroy()
		end

		return object
	end

	return StatCard
end

Modules["Tab"] = function()
	--[[
		Aurora UI  •  Tab.luau
		------------------------------------------------------------------
		One sidebar rail button + one scrolling page. Tabs animate their
		icon, carry an optional notification badge, and expose the layout
		helpers the demo uses (sections, grids, stat cards).
	--]]

	local Util = __req("Util")
	local Icons = __req("Icons")
	local Section = __req("Section")
	local StatCard = __req("StatCard")

	local Tab = {}

	function Tab.New(window, config: { [string]: any }, order: number?)
		config = config or {}

		local tab = {
			Name = config.Name or "Tab",
			Index = order or 1,
			Window = window,
			Active = false,
		}

		-- Rail geometry depends on the active style: an icon rail, a horizontal
		-- tab bar with labels, or a wide labelled sidebar.
		local railKind = Util.M("Rail", "rail")
		local tabShape = Util.M("TabShape", "rounded")
		-- dock and float both show their labels: one is a bottom bar, the other a
		-- detached column, and neither has room for an unlabelled icon alone.
		local labelled = railKind == "tabs" or railKind == "sidebar" or railKind == "dock"

		local size
		if railKind == "sidebar" then
			size = UDim2.new(1, 0, 0, 36)
		elseif railKind == "tabs" then
			size = UDim2.fromOffset(0, 38)
		elseif railKind == "dock" then
			size = UDim2.fromOffset(0, 42)
		elseif railKind == "float" then
			size = UDim2.fromOffset(50, 50)
		else
			size = UDim2.fromOffset(52, 52)
		end

		local radius
		if tabShape == "square" then
			radius = 0
		elseif tabShape == "pill" then
			radius = 999
		elseif railKind == "sidebar" then
			radius = 10
		elseif railKind == "dock" then
			radius = 12
		elseif railKind == "float" then
			radius = 10
		else
			radius = 15
		end

		-- Rail button ------------------------------------------------------
		local button = Util.New("Frame", {
			Name = "Tab_" .. tab.Name,
			BackgroundColor3 = Util.Theme.SurfaceHover,
			BackgroundTransparency = 1,
			Size = size,
			AutomaticSize = (railKind == "tabs" or railKind == "dock") and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
			BorderSizePixel = 0,
			LayoutOrder = order or 1,
			Parent = window._rail,
		})
		Util.Corner(radius, button)
		button.ClipsDescendants = labelled or false

		local fill = Util.Gradient(
			ColorSequence.new(Util.Theme.Accent, Util.Theme.Accent2),
			45,
			button
		)
		fill.Enabled = false
		Util.Themable(fill, "Color", function(palette)
			return ColorSequence.new(palette.Accent, palette.Accent2)
		end)

		local stroke = Util.Stroke(Util.Theme.Accent, 1, 1, button)
		Util.Themable(stroke, "Color", "Accent")

		-- Labelled variants keep the icon and the title in a padded content frame,
		-- so list layout never sees the full-size background layers.
		local content, label
		if labelled then
			content = Util.New("Frame", {
				Name = "Content",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Parent = button,
			})
			Util.Padding({ Left = 14, Right = 14 }, content)
			Util.List({
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = railKind == "sidebar" and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 9),
				Parent = content,
			})

		end

		local icon = Icons.Get(config.Icon or "dot", content or button, {
			Size = labelled and 15 or 20,
			Color = Util.Theme.TextMuted,
			Mask = Util.Theme.Surface,
		})
		if not labelled then
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.5)
		end

		if labelled then
			label = Util.Text({
				Name = "Label",
				Text = Util.M("HeaderCase", "normal") == "upper" and string.upper(config.Name or "") or (config.Name or ""),
				Font = Util.M("Mono", false) and Enum.Font.Code or Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = Util.Theme.TextMuted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.fromOffset(0, 18),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = content,
			})

			if railKind == "tabs" or railKind == "dock" then
				-- a horizontal bar needs a real width: AutomaticSize cannot
				-- resolve through a full-size content frame, so measure the label
				local textWidth = Util.TextWidth(label.Text, 12)
				if not textWidth or textWidth <= 0 then
					-- TextService is unavailable (or the measurement failed): fall back
					-- to an average glyph width so labels are never clipped
					textWidth = #label.Text * 7.4
				end
				local height = railKind == "dock" and 42 or 38
				button.Size = UDim2.fromOffset(math.max(railKind == "dock" and 78 or 88, math.floor(textWidth + 60)), height)
				button.AutomaticSize = Enum.AutomaticSize.None
			end
		end

		button:SetAttribute("Tooltip", config.Name or "Tab")

		-- Badge ------------------------------------------------------------
		local badge
		if config.Badge then
			badge = Util.New("Frame", {
				Name = "Badge",
				BackgroundColor3 = Util.Theme.Danger,
				Size = UDim2.fromOffset(0, 15),
				AutomaticSize = Enum.AutomaticSize.X,
				BorderSizePixel = 0,
				AnchorPoint = labelled and Vector2.new(1, 0.5) or Vector2.new(1, 0),
				Position = labelled and UDim2.new(1, -8, 0.5, 0) or UDim2.new(1, 2, 0, -2),
				ZIndex = button.ZIndex + 3,
				Parent = button,
			})
			Util.Corner(999, badge)
			Util.Padding({ X = 4 }, badge)
			Util.Themable(badge, "BackgroundColor3", "Danger")

			local badgeLabel = Util.Text({
				Name = "Count",
				Text = tostring(config.Badge),
				Font = Enum.Font.GothamBold,
				TextSize = 9,
				TextColor3 = Color3.new(1, 1, 1),
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromOffset(0, 15),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = badge,
			})
			tab.BadgeLabel = badgeLabel
		end

		-- Page -------------------------------------------------------------
		local page = Util.New("ScrollingFrame", {
			Name = "Page_" .. tab.Name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			BorderSizePixel = 0,
			Visible = false,
			ScrollBarThickness = Util.IsTouch() and 6 or 3,
			ScrollBarImageColor3 = Util.Theme.StrokeBright,
			ScrollBarImageTransparency = 0.5,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = window._pages,
		})
		Util.Padding({ Left = 2, Right = 8, Top = 2, Bottom = 12 }, page)
		Util.List({ Padding = UDim.new(0, 10), Parent = page })
		Util.Themable(page, "ScrollBarImageColor3", "StrokeBright")

		tab.Instance = button
		tab.Page = page
		tab.Icon = icon
		tab.Label = label
		tab.RailKind = railKind

		-- Hover / active visuals -------------------------------------------
		local hovered = false

		local function paint(animated: boolean)
			local palette = Util.Theme
			local active = tab.Active
			local background = active and palette.Accent or palette.SurfaceHover
			local transparency = active and 0 or (hovered and 0.35 or 1)
			local iconColor = active and palette.AccentText or (hovered and palette.Text or palette.TextMuted)

			fill.Enabled = active

			if animated then
				Util.Tween(button, { BackgroundTransparency = transparency }, "Fast")
				Util.Tween(stroke, { Transparency = active and 1 or 1 }, "Fast")
			else
				button.BackgroundTransparency = transparency
			end

			button.BackgroundColor3 = background
			Icons.Tint(icon, iconColor)
			Icons.Mask(icon, active and palette.Accent or palette.SurfaceHover)
			if label then
				label.TextColor3 = iconColor
			end
		end

		button.MouseEnter:Connect(function()
			hovered = true
			paint(true)
		end)
		button.MouseLeave:Connect(function()
			hovered = false
			paint(true)
		end)
		Util.OnClick(button, function()
			window:SelectTab(tab)
		end)

		paint(false)
		tab._paint = paint

		-- Layout helpers ---------------------------------------------------
		function tab.CreateSection(self, sectionConfig)
			return Section.New(window, page, sectionConfig)
		end

		--- Evenly spaced grid used by dashboards.
		function tab.AddGrid(self, gridConfig)
			gridConfig = gridConfig or {}
			local columns = gridConfig.Columns or 3
			local gap = gridConfig.Gap or 10
			local cellHeight = gridConfig.CellHeight or 96

			local grid = Util.New("Frame", {
				Name = "Grid",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = page,
			})

			Util.New("UIGridLayout", {
				CellSize = UDim2.new(1 / columns, -(gap * (columns - 1) / columns), 0, cellHeight),
				CellPadding = UDim2.fromOffset(gap, gap),
				FillDirectionMaxCells = columns,
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				StartCorner = Enum.StartCorner.TopLeft,
				Parent = grid,
			})

			return grid
		end

		--- Convenience: grid of stat cards in one call.
		function tab.AddStats(self, cards: { { [string]: any } }, gridConfig: { [string]: any }?)
			local grid = tab:AddGrid(gridConfig or { Columns = #cards, CellHeight = 92 })
			local built = {}
			for index, cardConfig in ipairs(cards) do
				local card = StatCard.New(window, grid, cardConfig)
				card.Instance.LayoutOrder = index
				table.insert(built, card)
			end
			return built, grid
		end

		function tab.AddSpacer(self, height: number)
			return Util.New("Frame", {
				Name = "Spacer",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, height),
				Parent = page,
			})
		end

		-- Public API -------------------------------------------------------
		function tab.SetActive(self, value: boolean)
			tab.Active = value
			page.Visible = value
			paint(true)
			if value then
				page.CanvasPosition = Vector2.new(0, 0)
			end
		end

		function tab.Select(self)
			window:SelectTab(tab)
		end

		function tab.SetBadge(self, value: number?)
			if not badge then
				return
			end
			if value == nil then
				badge.Visible = false
				return
			end
			badge.Visible = true
			tab.BadgeLabel.Text = tostring(value)
		end

		function tab.ScrollTo(self, instance: GuiObject)
			local pageTop = page.AbsolutePosition.Y
			local offset = instance.AbsolutePosition.Y - pageTop + page.CanvasPosition.Y
			Util.Tween(page, { CanvasPosition = Vector2.new(0, math.max(0, offset - 24)) }, "Smooth")
		end

		return tab
	end

	return Tab
end

Modules["Window"] = function()
	--[[
		Aurora UI  •  Window.luau
		------------------------------------------------------------------
		The application frame: screen container, glass backdrop, title bar
		with global search, icon rail, tab pages, status footer, overlay
		layer for popups/modals and a notification stack.

		Everything else in the library hangs off the window object.
	--]]

	local Util = __req("Util")
	local Theme = __req("Theme")
	local Styles = __req("Styles")
	local Icons = __req("Icons")
	local Tab = __req("Tab")
	local Notification = __req("Notification")
	local Tooltip = __req("Tooltip")

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	local player = Players.LocalPlayer

	local Window = {}

	local L = Theme.Layout

	------------------------------------------------------------------
	-- Small local builders
	------------------------------------------------------------------

	local function iconButton(parent, iconName, tooltip: string?)
		local button = Util.New("Frame", {
			Name = "IconButton_" .. iconName,
			BackgroundColor3 = Util.Theme.SurfaceHover,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(30, 30),
			BorderSizePixel = 0,
			Parent = parent,
		})
		Util.Corner(9, button)
		Util.Themable(button, "BackgroundColor3", "SurfaceHover")

		local icon = Icons.Get(iconName, button, {
			Size = 13,
			Color = Util.Theme.TextMuted,
			Mask = Util.Theme.Panel,
		})
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)

		button.MouseEnter:Connect(function()
			Util.Tween(button, { BackgroundTransparency = 0 }, "Fast")
			Icons.Tint(icon, Util.Theme.Text)
		end)
		button.MouseLeave:Connect(function()
			Util.Tween(button, { BackgroundTransparency = 1 }, "Fast")
			Icons.Tint(icon, Util.Theme.TextMuted)
		end)

		if tooltip then
			button:SetAttribute("Tooltip", tooltip)
		end

		return button, icon
	end

	------------------------------------------------------------------
	-- Constructor
	------------------------------------------------------------------

	function Window.New(config: { [string]: any })
		config = config or {}

		local self = {}
		self.Tabs = {}
		self.ActiveTab = nil
		self.SearchIndex = {}
		self._toasts = {}
		self.Alive = true

		-- Style ------------------------------------------------------------
		-- A style is a palette *plus* its geometry: radius, border weight,
		-- rail layout, card treatment. `Theme` alone still works and keeps the
		-- Midnight geometry.
		local style = Styles.Get(config.Style or config.Theme)
		local metrics = Styles.Metrics(style)
		Util.ApplyStyle(metrics)
		self.Style = style
		self.Metrics = metrics
		self.StyleName = style.Name
		self.ThemeName = style.Name

		-- 4.0 -- the blueprint -------------------------------------------------
		-- The style also decides what the window is *made of*, not just what
		-- colour it is. These three numbers are read before a single frame is
		-- created, so the body, the pages and the footer all agree on where the
		-- chrome ends.
		local layout = Styles.Layout(style)
		local motion = Styles.Motion(style)
		self.Layout = layout
		self.Motion = motion

		local headerHeight = if layout.Header == "hero"
			then 92
			elseif layout.Header == "strip" then 44
			else L.TitleBarHeight
		local footerHeight = if layout.Footer == "none"
			then 0
			elseif layout.Footer == "ticker" then 27
			else L.FooterHeight
		local dockHeight = if layout.Nav == "dock" then 68 else 0

		self.HeaderHeight = headerHeight
		self.FooterHeight = footerHeight

		-- Staggered entrance: every direct child of the body slides in, in
		-- reading order, using the style's own motion profile.
		local Anim = __req("Anim")
		self._anim = Anim
		self._motion = motion
		self._layout = layout

		local width = config.Width or L.WindowWidth
		local height = config.Height or L.WindowHeight

		-- Palette ----------------------------------------------------------
		Util.ApplyTheme(Theme.Get(self.ThemeName))

		-- Screen container --------------------------------------------------
		local gui = Util.New("ScreenGui", {
			Name = "AuroraUI",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 100,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
